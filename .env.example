# ─────────────────────────────────────────────────────────────
#  Biến môi trường — sao chép file này thành `.env` và điền giá trị
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Endpoint WPGraphQL của WordPress (bắt buộc)
WORDPRESS_GRAPHQL_URL="http://localhost:8888/example/graphql"

# Base URL ảnh upload của WordPress (có dấu / ở cuối)
WP_UPLOADS_BASE_URL="https://cms.example.com/wp-content/uploads/"

# Domain frontend công khai (không có dấu / ở cuối)
PUBLIC_SITE_URL="https://example.com"

# Hostname CMS (chỉ host, không protocol)
PUBLIC_CMS_DOMAIN="cms.example.com"

# ── Widget chat (tùy chọn — chỉ nhúng khi có PUBLIC_WIDGET_URL) ──
# Nếu dùng widget chat của bên thứ ba, điền URL + ID nhà cung cấp.
# Lưu ý: biến global trong code là `window.VarenoChat` — phải KHỚP
# với script widget của nhà cung cấp. Bỏ trống nếu chưa dùng.
# PUBLIC_WIDGET_URL="https://app.example.com"
# PUBLIC_WIDGET_ID=""
