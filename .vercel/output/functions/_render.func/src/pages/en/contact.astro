<script>
  // 1. Logic Form Submit (Web3Forms)
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const formView = document.getElementById("form-view");
  const successView = document.getElementById("success-view");
  const newRequestBtn = document.getElementById(
    "new-request-btn",
  ) as HTMLButtonElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  if (form && formView && successView && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const originalBtnHTML = submitBtn.innerHTML;
      submitBtn.innerHTML =
        '<span>Processing...</span><svg class="animate-spin h-5 w-5 ml-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
      submitBtn.disabled = true;
      submitBtn.style.opacity = "0.7";
      submitBtn.style.cursor = "not-allowed";

      const formData = new FormData(form);

      try {
        const fetchUrl = "https://" + "api.web" + "3forms.com/" + "submit";
        const response = await fetch(fetchUrl, {
          method: "POST",
          body: formData,
        });
        const data = await response.json();
        if (data.success) {
          formView.classList.add("hidden");
          successView.classList.remove("hidden");
        } else {
          alert(
            "Server warning: " +
              data.message +
              "\n\n💡 Hint: Have you entered your Web3Forms Access Key?",
          );
        }
      } catch (error) {
        alert(
          "Unable to connect to the email system. Please check your internet connection!",
        );
      } finally {
        submitBtn.innerHTML = originalBtnHTML;
        submitBtn.disabled = false;
        submitBtn.style.opacity = "1";
        submitBtn.style.cursor = "pointer";
      }
    });
  }

  if (newRequestBtn && form) {
    newRequestBtn.addEventListener("click", () => {
      form.reset();
      const subjectValue = document.getElementById("subject-value");
      const subjectInput = document.getElementById(
        "subject-input",
      ) as HTMLInputElement;
      if (subjectValue && subjectInput) {
        subjectValue.textContent = "Choose a subject";
        subjectValue.classList.remove("text-foreground");
        subjectValue.classList.add("text-muted-foreground");
        subjectInput.value = "";
      }
      if (successView) successView.classList.add("hidden");
      if (formView) formView.classList.remove("hidden");
    });
  }

  // 2. Custom Select Dropdown
  const selectBtn = document.getElementById("select-btn");
  const selectMenu = document.getElementById("select-menu");
  const subjectValue = document.getElementById("subject-value");
  const subjectInput = document.getElementById(
    "subject-input",
  ) as HTMLInputElement;

  if (selectBtn && selectMenu) {
    selectBtn.addEventListener("click", () => {
      selectMenu.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (
        !selectBtn.contains(e.target as Node) &&
        !selectMenu.contains(e.target as Node)
      ) {
        selectMenu.classList.add("hidden");
      }
    });

    const options = selectMenu.querySelectorAll(".select-option");
    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const val = opt.getAttribute("data-value");
        if (val && subjectValue && subjectInput) {
          subjectValue.textContent = val;
          subjectValue.classList.remove("text-muted-foreground");
          subjectValue.classList.add("text-foreground");
          subjectInput.value = val;
        }
        selectMenu.classList.add("hidden");
      });
    });
  }

  // 3. Stats Observer for Animation
  const statsContainer = document.getElementById("stats-container");
  let hasAnimated = false;

  const animateValue = (el: HTMLElement, end: number, duration: number) => {
    const startTime = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(eased * end);
      el.textContent = current.toString();
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = end.toString();
      }
    };
    requestAnimationFrame(step);
  };

  if (statsContainer && window.IntersectionObserver) {
    const runStats = () => {
      if (hasAnimated) return;
      hasAnimated = true;
      document.querySelectorAll(".stat-number").forEach((stat) => {
        const end = parseInt(stat.getAttribute("data-end") || "0", 10);
        animateValue(stat, end, 1500);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          runStats();
          observer.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(statsContainer);
  }
</script>

<script
  is:inline
  define:vars={{
    WP_GRAPHQL_URL: SITE.graphqlUrl,
  }}
>
  // ── WordPress Live Content Polling (English page) ─────────
  (function () {
    const WP_GRAPHQL = WP_GRAPHQL_URL;
    const POLL_MS = 5000;

    const GQL = `query {
      page(id: "contact", idType: URI) {
        contactPageFields {
          heroBadge heroTitle heroSubtitle contactStatusText
          contactBranchAddress contactAddress contactPhone contactEmail
          contactFacebookUrl contactYoutubeUrl contactTiktokUrl contactLinkedinUrl
        }
      }
    }`;

    const GQL_FALLBACK = `query {
      page(id: "lien-he", idType: URI) {
        contactPageFields {
          heroBadge heroTitle heroSubtitle contactStatusText
          contactBranchAddress contactAddress contactPhone contactEmail
          contactFacebookUrl contactYoutubeUrl contactTiktokUrl contactLinkedinUrl
        }
      }
    }`;

    async function fetchData() {
      try {
        const r = await fetch(WP_GRAPHQL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({ query: GQL }),
        });
        const j = await r.json();
        const f = j?.data?.page?.contactPageFields;
        if (f) return f;

        const r2 = await fetch(WP_GRAPHQL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({ query: GQL_FALLBACK }),
        });
        const j2 = await r2.json();
        return j2?.data?.page?.contactPageFields ?? null;
      } catch {
        return null;
      }
    }

    function setText(id, value) {
      if (!value) return;
      const el = document.getElementById(id);
      if (el && el.textContent.trim() !== String(value).trim()) {
        el.textContent = value;
      }
    }

    function setHref(ariaLabel, value) {
      if (!value) return;
      const el = document.querySelector(`a[aria-label="${ariaLabel}"]`);
      if (el && el.getAttribute("href") !== value) {
        el.setAttribute("href", value);
      }
    }

    async function poll() {
      const d = await fetchData();
      if (!d) return;
      setText("wp-hero-badge", d.heroBadge);
      setText("wp-hero-title", d.heroTitle);
      setText("wp-hero-subtitle", d.heroSubtitle);
      setText("wp-contact-status", d.contactStatusText);
      setText("wp-contact-branch-address", d.contactBranchAddress);
      setText("wp-contact-address", d.contactAddress);
      setText("wp-contact-phone", d.contactPhone);
      setText("wp-contact-email", d.contactEmail);
      setHref("Facebook", d.contactFacebookUrl);
      setHref("YouTube", d.contactYoutubeUrl);
      setHref("TikTok", d.contactTiktokUrl);
      setHref("LinkedIn", d.contactLinkedinUrl);
    }

    setInterval(poll, POLL_MS);
  })();
</script>

