---
// /chatvareno/ — NHÚNG site thật chatvareno.com trong iframe.
// URL trình duyệt vẫn là /chatvareno/ (local); nội dung là site production.
// Xem src/layouts/FrameLayout.astro và trường externalUrl trong config/products.ts.
import FrameLayout from "../layouts/FrameLayout.astro";
import { findProduct } from "../config/products";

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=3600, stale-while-revalidate=86400",
);

const product = findProduct("chatvareno");
const base = product.externalUrl ?? "";
---

<FrameLayout
  iframeSrc={`${base}/`}
  label={product.name}
  title={product.seo.vi.title}
  description={product.seo.vi.description}
  lang="vi"
/>
