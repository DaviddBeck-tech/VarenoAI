---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NotFoundHero from "../components/NotFoundHero.astro";
import { SITE } from "../config/site";
import { NAV } from "../config/nav";

// Trả HTTP 404 thật. Trước đây /404 trả 200 (soft-404) vì nó là route
// hợp lệ được redirect tới — Google coi đó là trang tồn tại.
Astro.response.status = 404;

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={`404 — Trang không tồn tại · ${SITE.brandName}`}
  description="Trang bạn đang tìm kiếm không tồn tại."
>
  <Header />

  <NotFoundHero
    heading="Không tìm thấy trang"
    homeLabel="Về trang chủ"
    homeHref={NAV.home}
    contactLabel="Liên hệ"
    contactHref={NAV.contact}
  />

  <Footer />
</BaseLayout>
