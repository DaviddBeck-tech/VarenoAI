---
// Hero gọn cho các trang tĩnh (/services/, /about/, /solutions/).
// Tách ra để không phải lặp cùng một khối markup ở 3 trang × 2 ngôn ngữ.
interface Props {
  badge?: string | null;
  title: string;
  titleHighlight?: string | null;
  subtitle?: string | null;
}

const { badge, title, titleHighlight, subtitle } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <div class="ph-inner">
      {badge && <span class="ph-badge">{badge}</span>}

      <h1 class="ph-title">
        {title}
        {titleHighlight && <span class="ph-highlight">{titleHighlight}</span>}
      </h1>

      {subtitle && <p class="ph-subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style>
  .page-hero {
    /* Header cao 64px và position:fixed → chừa chỗ ở trên */
    padding: 9rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 80% at 50% 0%,
      hsl(var(--primary) / 0.1) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .ph-inner {
    position: relative;
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
  }

  .ph-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    border: 1px solid hsl(var(--primary) / 0.2);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .ph-title {
    font-family: "Google Sans", sans-serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .ph-highlight {
    background: linear-gradient(
      90deg,
      hsl(var(--primary)),
      hsl(var(--accent))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ph-subtitle {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
    margin: 1.25rem auto 0;
    max-width: 40rem;
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 7rem 0 2.5rem;
    }
  }
</style>
