---
// src/components/LanguageSwitcher.astro

const { pathname } = Astro.url;

// Xác định xem trang hiện tại có phải là tiếng Anh không
const isEnglish = pathname.startsWith("/en/") || pathname === "/en";

// Tạo URL cho nút Tiếng Việt: Xóa prefix '/en'
let viPath = pathname;
if (isEnglish) {
  viPath = pathname.replace(/^\/en(\/|$)/, "/");
}

// Tạo URL cho nút English: Thêm prefix '/en'
let enPath = pathname;
if (!isEnglish) {
  enPath = `/en${pathname === "/" ? "" : pathname}`;
}
---

<div class="relative inline-block text-left lang-switcher-container">
  {/* Nút Kích hoạt (Trigger Button) */}
  <button
    type="button"
    class="lang-switcher-btn inline-flex items-center justify-center w-9 h-9 rounded-full text-muted-foreground hover:text-foreground hover:bg-primary/40 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 dark:focus:ring-offset-background cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Chọn ngôn ngữ / Select language"
  >
    {/* Icon Quả địa cầu nét mảnh (Globe icon) */}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>
  </button>

  {/* Khối Menu Dropdown */}
  <div
    class="lang-switcher-menu origin-top-right absolute right-0 mt-2 w-44 rounded-xl shadow-lg bg-background border border-border/50 ring-1 ring-black/5 dark:ring-white/5 opacity-0 invisible scale-95 transition-all duration-200 ease-out z-50"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="py-1.5" role="none">
      {/* Tùy chọn: Tiếng Việt */}
      <a
        href={viPath}
        class={`group flex items-center justify-between px-3.5 py-2.5 mx-1.5 rounded-lg text-sm transition-colors ${
          !isEnglish
            ? "bg-secondary/60 font-medium text-foreground dark:bg-secondary"
            : "text-muted-foreground hover:bg-secondary/40 hover:text-foreground"
        }`}
        role="menuitem"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-base leading-none">🇻🇳</span>
          <span>Tiếng Việt</span>
        </div>
        {
          !isEnglish && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-foreground/80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          )
        }
      </a>

      {/* Tùy chọn: English */}
      <a
        href={enPath}
        class={`group flex items-center justify-between px-3.5 py-2.5 mx-1.5 mt-1 rounded-lg text-sm transition-colors ${
          isEnglish
            ? "bg-secondary/60 font-medium text-foreground dark:bg-secondary"
            : "text-muted-foreground hover:bg-secondary/40 hover:text-foreground"
        }`}
        role="menuitem"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-base leading-none">🇬🇧</span>
          <span>English</span>
        </div>
        {
          isEnglish && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-foreground/80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          )
        }
      </a>
    </div>
  </div>
</div>

<script>
  const setupLangSwitcher = () => {
    const containers = document.querySelectorAll(".lang-switcher-container");

    containers.forEach((container) => {
      const btn = container.querySelector(".lang-switcher-btn");
      const menu = container.querySelector(".lang-switcher-menu");

      if (!btn || !menu) return;

      // Remove previously attached listeners if any (useful for view transitions)
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      const updatedBtn = container.querySelector(".lang-switcher-btn");

      updatedBtn?.addEventListener("click", (e) => {
        // Do not stop propagation so document click listener can close OTHER menus
        const isExpanded = updatedBtn.getAttribute("aria-expanded") === "true";

        // Close all other menus first
        document.querySelectorAll(".lang-switcher-container").forEach(other => {
          if (other !== container) {
            const otherBtn = other.querySelector(".lang-switcher-btn");
            const otherMenu = other.querySelector(".lang-switcher-menu");
            otherBtn?.setAttribute("aria-expanded", "false");
            otherMenu?.classList.remove("visible", "opacity-100", "scale-100");
            otherMenu?.classList.add("invisible", "opacity-0", "scale-95");
          }
        });

        updatedBtn.setAttribute("aria-expanded", !isExpanded ? "true" : "false");

        if (!isExpanded) {
          menu.classList.remove("invisible", "opacity-0", "scale-95");
          menu.classList.add("visible", "opacity-100", "scale-100");
        } else {
          menu.classList.remove("visible", "opacity-100", "scale-100");
          menu.classList.add("invisible", "opacity-0", "scale-95");
        }
      });
    });
  };

  // Attach a single global document click listener
  if (!(window as any)._langSwitcherGlobalClick) {
    (window as any)._langSwitcherGlobalClick = true;
    document.addEventListener("click", (event) => {
      document.querySelectorAll(".lang-switcher-container").forEach((container) => {
        const btn = container.querySelector(".lang-switcher-btn");
        const menu = container.querySelector(".lang-switcher-menu");
        
        if (!container.contains(event.target as Node) && btn?.getAttribute("aria-expanded") === "true") {
          btn.setAttribute("aria-expanded", "false");
          menu?.classList.remove("visible", "opacity-100", "scale-100");
          menu?.classList.add("invisible", "opacity-0", "scale-95");
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        document.querySelectorAll(".lang-switcher-container").forEach((container) => {
          const btn = container.querySelector(".lang-switcher-btn");
          const menu = container.querySelector(".lang-switcher-menu");
          
          if (btn?.getAttribute("aria-expanded") === "true") {
            btn.setAttribute("aria-expanded", "false");
            menu?.classList.remove("visible", "opacity-100", "scale-100");
            menu?.classList.add("invisible", "opacity-0", "scale-95");
            (btn as HTMLElement).focus();
          }
        });
      }
    });
  }

  setupLangSwitcher();
  document.addEventListener("astro:page-load", setupLangSwitcher);
</script>
