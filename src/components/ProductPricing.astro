---
// ── BẢNG GIÁ THEO SẢN PHẨM — TAB (trang /services/) ─────────────────
// Bấm tab một sản phẩm → hiện bảng giá của sản phẩm đó. Sản phẩm coming-soon
// (ContentAI) → hiện trạng thái "Sắp ra mắt", KHÔNG dựng bảng giá giả.
//
// CỐ Ý KHÔNG tái dùng PricingSection: component đó hardcode id ("pricing",
// "pricing-toggle-btn"...), render 2 lần trên một trang là trùng id ⇒ toggle
// hỏng. Ở đây tự chứa, id/scope theo instance, và toggle tháng/năm bị bỏ (giá
// tạm chỉ theo tháng) cho gọn.
//
// A11y: role=tablist/tab/tabpanel, roving tabindex, phím mũi tên trái/phải,
// deep-link #<id sản phẩm>. Nội dung mọi panel NẰM SẴN trong DOM (chỉ ẩn bằng
// [hidden]) nên máy tìm kiếm vẫn đọc được.
import ProductIcon from "./ProductIcon.astro";

interface Tier {
  name: string;
  price: string;
  period: string;
  desc: string;
  features: string[];
  highlighted?: boolean;
  ctaLabel: string;
  ctaHref: string;
}

interface ProductTab {
  id: string;
  name: string;
  icon: string;
  status: "live" | "coming-soon";
  tiers?: Tier[] | null;
}

interface Props {
  eyebrow: string;
  heading: string;
  subheading?: string | null;
  note?: string | null;
  comingSoonBadge: string;
  comingSoonTitle: string;
  comingSoonDesc: string;
  comingSoonCta: string;
  comingSoonHref: string;
  popularLabel: string;
  products: ProductTab[];
}

const {
  eyebrow,
  heading,
  subheading,
  note,
  comingSoonBadge,
  comingSoonTitle,
  comingSoonDesc,
  comingSoonCta,
  comingSoonHref,
  popularLabel,
  products,
} = Astro.props;
---

<section class="pp-section" id="pricing">
  <div class="container">
    <header class="pp-head">
      <span class="pp-eyebrow">{eyebrow}</span>
      <h2 class="pp-heading">{heading}</h2>
      {subheading && <p class="pp-subheading">{subheading}</p>}
    </header>

    <div class="pp-tabs" role="tablist" aria-label={heading}>
      {
        products.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`pp-tab-${p.id}`}
            class="pp-tab"
            aria-controls={`pp-panel-${p.id}`}
            aria-selected={i === 0}
            tabindex={i === 0 ? 0 : -1}
            data-pp-tab={p.id}
          >
            <ProductIcon name={p.icon} size={18} />
            <span>{p.name}</span>
            {p.status === "coming-soon" && (
              <em class="pp-tab-badge">{comingSoonBadge}</em>
            )}
          </button>
        ))
      }
    </div>

    {
      products.map((p, i) => (
        <div
          role="tabpanel"
          id={`pp-panel-${p.id}`}
          class="pp-panel"
          aria-labelledby={`pp-tab-${p.id}`}
          data-pp-panel={p.id}
          hidden={i !== 0}
        >
          {p.tiers && p.tiers.length > 0 ? (
            <div class="pp-grid">
              {p.tiers.map((tier) => (
                <div class:list={["pp-card", { "pp-card--hl": tier.highlighted }]}>
                  {tier.highlighted && (
                    <span class="pp-card-pop">{popularLabel}</span>
                  )}
                  <h3 class="pp-card-name">{tier.name}</h3>
                  <p class="pp-card-desc">{tier.desc}</p>
                  <div class="pp-card-price">
                    <span class="pp-price">{tier.price}</span>
                    <span class="pp-period">{tier.period}</span>
                  </div>
                  <ul class="pp-features" role="list">
                    {tier.features.map((f) => (
                      <li>
                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={tier.ctaHref}
                    class:list={["pp-cta", tier.highlighted ? "pp-cta--primary" : "pp-cta--outline"]}
                  >
                    {tier.ctaLabel}
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <div class="pp-soon">
              <span class="pp-soon-icon">
                <ProductIcon name={p.icon} size={30} />
              </span>
              <span class="pp-soon-badge">{comingSoonBadge}</span>
              <h3 class="pp-soon-title">{comingSoonTitle}</h3>
              <p class="pp-soon-desc">{comingSoonDesc}</p>
              <a href={comingSoonHref} class="pp-cta pp-cta--primary">
                {comingSoonCta}
              </a>
            </div>
          )}
        </div>
      ))
    }

    {note && <p class="pp-note">{note}</p>}
  </div>
</section>

<script>
  function initProductPricing() {
    document.querySelectorAll<HTMLElement>(".pp-section").forEach((section) => {
      const tabs = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
      );
      if (tabs.length === 0) return;

      function activate(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.ppTab === id;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.ppPanel !== id;
        });
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => activate(tab.dataset.ppTab || ""));
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const dir = e.key === "ArrowRight" ? 1 : -1;
          const next = tabs[(i + dir + tabs.length) % tabs.length];
          activate(next.dataset.ppTab || "", true);
        });
      });

      // Deep-link: /services#<id sản phẩm> mở đúng tab.
      const hash = location.hash.replace("#", "");
      if (hash && tabs.some((t) => t.dataset.ppTab === hash)) activate(hash);
    });
  }

  initProductPricing();
  document.addEventListener("astro:page-load", initProductPricing);
</script>

<style>
  .pp-section {
    padding: 5rem 0;
    /* Nền wash một sắc thương hiệu, giống PricingSection để "cảm giác giá". */
    background: linear-gradient(
      180deg,
      hsl(var(--background)) 0%,
      hsl(var(--primary) / 0.05) 45%,
      hsl(var(--primary) / 0.1) 100%
    );
  }
  :global(.dark) .pp-section {
    background: linear-gradient(
      180deg,
      hsl(var(--background)) 0%,
      hsl(var(--primary) / 0.07) 45%,
      hsl(var(--primary) / 0.14) 100%
    );
  }

  .pp-head {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2rem;
  }
  .pp-eyebrow {
    display: inline-block;
    font-family: "Roboto", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    margin-bottom: 0.875rem;
  }
  .pp-heading {
    font-family: "Google Sans", sans-serif;
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }
  .pp-subheading {
    font-size: var(--fs-lead);
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  /* ── Tab switcher: segmented control giữa trang ─────────────── */
  .pp-tabs {
    display: inline-flex;
    gap: 0.375rem;
    margin: 0 auto 2.5rem;
    padding: 0.375rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card));
    /* căn giữa khối inline-flex */
    display: flex;
    width: fit-content;
    flex-wrap: wrap;
    justify-content: center;
  }
  .pp-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-family: "Google Sans", sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .pp-tab:hover {
    color: hsl(var(--foreground));
  }
  .pp-tab[aria-selected="true"] {
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
  }
  .pp-tab:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  .pp-tab-badge {
    font-style: normal;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }
  .pp-tab[aria-selected="true"] .pp-tab-badge {
    background: hsl(var(--primary-foreground) / 0.2);
    color: hsl(var(--primary-foreground));
  }

  /* ── Lưới tiers ─────────────────────────────────────────────── */
  .pp-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: none;
    margin: 0 auto;
    align-items: stretch;
  }
  .pp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--shape-card);
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card));
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pp-card:hover {
    border-color: hsl(var(--primary) / 0.55);
    box-shadow: 0 8px 24px -18px hsl(var(--primary) / 0.45);
  }
  .pp-card--hl {
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: 0 0 0 1px hsl(var(--primary) / 0.3), var(--elev-2);
  }
  .pp-card-pop {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .pp-card-name {
    font-family: "Google Sans", sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: hsl(var(--foreground));
    margin: 0 0 0.2rem;
  }
  .pp-card-desc {
    font-size: 0.75rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
    margin: 0 0 0.8rem;
    min-height: 2.6em;
  }
  .pp-card-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.9rem;
  }
  .pp-price {
    font-family: "Google Sans", sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
  }
  .pp-period {
    font-size: 0.7rem;
    color: hsl(var(--muted-foreground));
  }
  .pp-features {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    flex: 1;
  }
  .pp-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: 0.72rem;
    line-height: 1.35;
    color: hsl(var(--foreground) / 0.9);
  }
  .pp-features svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    fill: none;
    stroke: hsl(var(--primary));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.6rem 0.7rem;
    border-radius: var(--shape-btn);
    font-family: "Roboto", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pp-cta--primary {
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
  }
  .pp-cta--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -12px hsl(var(--primary) / 0.6);
  }
  .pp-cta--outline {
    color: hsl(var(--foreground));
    background: transparent;
    border: 1px solid hsl(var(--border));
  }
  .pp-cta--outline:hover {
    border-color: hsl(var(--primary) / 0.5);
    color: hsl(var(--primary));
  }
  .pp-cta:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }

  /* ── Trạng thái coming-soon ─────────────────────────────────── */
  .pp-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.875rem;
    max-width: 34rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 3.5rem);
    border-radius: var(--shape-card);
    border: 1px dashed hsl(var(--border));
    background: hsl(var(--card) / 0.6);
  }
  .pp-soon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--shape-btn);
    color: hsl(var(--muted-foreground));
    background: hsl(var(--muted));
  }
  .pp-soon-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    border: 1px solid hsl(var(--primary) / 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }
  .pp-soon-title {
    font-family: "Google Sans", sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: hsl(var(--foreground));
    margin: 0;
  }
  .pp-soon-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
    margin: 0 0 0.5rem;
  }
  .pp-soon .pp-cta {
    width: auto;
    padding-inline: 1.75rem;
  }

  .pp-note {
    text-align: center;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    margin: 2rem 0 0;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .pp-grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
    }
  }
  @media (max-width: 560px) {
    .pp-section {
      padding: 3.5rem 0;
    }
    .pp-tab {
      padding: 0.5rem 0.85rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-card,
    .pp-cta {
      transition: none;
    }
    .pp-cta--primary:hover {
      transform: none;
    }
  }
</style>
