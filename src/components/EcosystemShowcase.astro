---
// ─────────────────────────────────────────────────────────────
//  ECOSYSTEM SHOWCASE — trung tâm của trang chủ umbrella
// ─────────────────────────────────────────────────────────────
//  Mỗi sản phẩm là một THẺ MỞ RỘNG: thu gọn chỉ có ảnh giao diện + tên + nút
//  cộng; bấm vào thì thẻ nở ra thành một tấm lớn có mô tả, điểm chính và CTA.
//  Bố cục và cách chuyển cảnh mượn từ `Expandable Card` (21st.dev #4073).
//
//  Bản gốc morph bằng framer-motion `layoutId`. Dự án này có 14 dependency và
//  không có framer-motion, nên phần morph viết lại bằng View Transition API:
//  gán CÙNG một `view-transition-name` cho phần tử ở thẻ thu gọn (ảnh cũ) rồi
//  cho phần tử tương ứng trong <dialog> (ảnh mới), trình duyệt tự nội suy vị
//  trí, kích thước và bo góc. Đã đo: phần tử con của <dialog> vẫn giữ được
//  view-transition-name sau showModal(), tức top layer KHÔNG chặn morph.
//
//  Vì sao <dialog> + showModal() chứ không phải một <div> overlay: nó cho sẵn
//  bẫy focus, Escape, `inert` cho phần nền, top layer và khôi phục focus về
//  nút đã bấm. Bản 21st tự dựng lại từng thứ đó bằng useEffect và vẫn thiếu
//  bẫy focus; nó còn đặt role="dialog" aria-modal lên chính THẺ THU GỌN, và
//  lồng <button> trong một div có onClick. Không chép các lỗi đó.
//
//  Trình duyệt không có View Transition (hoặc người dùng bật reduced-motion):
//  dialog vẫn mở/đóng bình thường, chỉ không có morph. Không có JS: thẻ hiện
//  đủ ảnh + tên, và <dialog> đóng nên không chắn gì. Link sản phẩm nằm SẴN
//  trong DOM ⇒ máy tìm kiếm vẫn thấy đường tới /chatvareno/ và /contentai/.
//
//  Prefix .ecs- (không phải .eco-) để không đụng CSS của component đã xoá.
import type { ImageMetadata } from "astro";
import ProductIcon from "./ProductIcon.astro";
import { navProducts, productPath } from "../config/products";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

// CỐ Ý dùng <img> thay vì <Image> của astro:assets: astro.config.mjs bật
// vercel({ imageService: true }), khiến /_image trả "500 Invalid endpoint" khi
// chạy `astro dev`. Import tĩnh vẫn cho src đã băm + width/height thật.
import chatvarenoShot from "../assets/app-mockup.png";
import contentaiShot from "../assets/Layout_1.png";

/**
 * Ảnh giao diện theo id sản phẩm. Cố ý KHÔNG nhét vào products.ts: registry là
 * dữ liệu thuần, còn đây là asset của riêng section này. Thiếu ảnh thì rơi về
 * slot có nhãn, nên thêm sản phẩm mới vẫn không phải sửa file này.
 *
 * TODO(ảnh): cần screenshot ContentAI, tỉ lệ 1.65:1 (khớp app-mockup.png
 * 2048×1240), nền sáng.
 */
const SHOTS: Record<string, ImageMetadata> = {
  chatvareno: chatvarenoShot,
  contentai: contentaiShot,
};

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const products = navProducts();

/**
 * Số cột của lưới sản phẩm. Chỉ có 1 hoặc 2.
 *
 * KHÔNG dùng `repeat(auto-fit, minmax(22rem, 1fr))`: số cột khi đó do bề rộng
 * quyết định, nên 4 sản phẩm ở 1440px ra 3 cột + 1 thẻ lẻ loi ở hàng dưới.
 *
 * Trần 2 cột: thẻ có ảnh cần bề rộng, 3 cột trở lên thì screenshot thành tem.
 * Số lẻ do CSS lo: ô cuối nếu phải đứng một mình thì chiếm cả hàng.
 */
const cols = products.length === 1 ? 1 : 2;
---

<section class="ecs-section">
  <div class="container">
    <header class="ecs-header">
      <h2 class="ecs-title">{title}</h2>
      <p class="ecs-subtitle">{subtitle}</p>
    </header>

    <ul
      class="ecs-grid"
      role="list"
      data-cols={String(cols)}
      style={`--cols:${cols}`}
    >
      {
        products.map((p, i) => {
          const shot = SHOTS[p.id];
          return (
            <li style={`--i:${i}`}>
              {/* Toàn bộ thẻ LÀ nút. Không lồng <button> trong <button>: nút
                  cộng ở góc chỉ là trang trí, aria-label của nút mẹ đã đủ. */}
              <button
                type="button"
                class="ecs-card"
                data-product={p.id}
                data-status={p.status}
                aria-haspopup="dialog"
                aria-controls={`ecs-dlg-${p.id}`}
                aria-label={`${t("products.openCard")} ${p.name}`}
              >
                <span class="ecs-card-shot">
                  {shot ? (
                    /* alt="" — ảnh này lặp lại trong dialog kèm alt thật, và
                       nút mẹ đã có aria-label. Đọc hai lần là ồn. */
                    <img
                      src={shot.src}
                      width={shot.width}
                      height={shot.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                      ) : (
                    /* Slot CÓ NHÃN, không phải giao diện giả dựng bằng <div> */
                    <span class="ecs-slot">
                      <ProductIcon name={p.icon} size={34} />
                      <span>{t("products.previewSoon")}</span>
                    </span>
                  )}
                </span>

                <span class="ecs-card-foot">
                  <span class="ecs-card-meta">
                    <span class="ecs-card-tagline">{p.tagline[lang]}</span>
                    <span class="ecs-card-name">{p.name}</span>
                  </span>
                  <span class="ecs-plus" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
                      <path d="M5 12h14" />
                      <path d="M12 5v14" />
                    </svg>
                  </span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>

    {
      products.map((p) => {
        const shot = SHOTS[p.id];
        const highlights = p.highlights?.[lang] ?? [];
        return (
          <dialog
            id={`ecs-dlg-${p.id}`}
            class="ecs-dialog"
            data-product={p.id}
            aria-labelledby={`ecs-dlg-${p.id}-title`}
          >
            <div class="ecs-panel" data-status={p.status}>
              <div class="ecs-panel-shot">
                {shot ? (
                  <img
                    src={shot.src}
                    width={shot.width}
                    height={shot.height}
                    alt={`${t("products.uiPreview")} ${p.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="ecs-slot">
                    <ProductIcon name={p.icon} size={42} />
                    <span>{t("products.previewSoon")}</span>
                  </div>
                )}
              </div>

              {/* Đầu thẻ nằm NGOÀI vùng cuộn ⇒ nút đóng không bao giờ trôi mất */}
              <div class="ecs-panel-head">
                <div class="ecs-panel-meta">
                  <p class="ecs-panel-tagline">{p.tagline[lang]}</p>
                  <h3 class="ecs-panel-name" id={`ecs-dlg-${p.id}-title`}>
                    {p.name}
                  </h3>
                </div>
                <button
                  type="button"
                  class="ecs-plus ecs-plus--close"
                  data-close
                  autofocus
                  aria-label={t("products.closeCard")}
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                  </svg>
                </button>
              </div>

              <div class="ecs-panel-body">
                <p class="ecs-panel-desc">{p.description[lang]}</p>

                {highlights.length > 0 && (
                  <div class="ecs-hl-block">
                    <p class="ecs-panel-label">{t("products.highlights")}</p>
                    <ul class="ecs-hl" role="list">
                      {highlights.map((h) => (
                        <li>
                          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                            <path d="M20 6 9 17l-5-5" />
                          </svg>
                          {h}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {/* Link THẬT: giữ đường dẫn nội bộ tới trang sản phẩm mà thẻ
                    <a> cũ vẫn cung cấp. <dialog> đóng vẫn nằm trong DOM. */}
                <a class="ecs-panel-cta" href={translatePath(productPath(p))}>
                  {t("products.learnMore")}
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </dialog>
        );
      })
    }
  </div>
</section>

<script>
  // ── Thẻ mở rộng: morph bằng View Transition, a11y bằng <dialog> ──────────
  //
  // Tên view-transition là HẰNG SỐ (không kèm id sản phẩm) vì tại một thời
  // điểm chỉ có đúng một thẻ đang chuyển cảnh. Nhờ vậy CSS ở dưới nhắm được
  // đích danh từng tên, không phải dựa vào `::view-transition-group(*)` —
  // selector đó Safari mới hỗ trợ gần đây.
  //
  // Mỗi cặp: [tên, selector ở thẻ thu gọn, selector trong dialog]
  const PAIRS: [string, string, string][] = [
    ["ecs-card", ".ecs-card", ".ecs-panel"],
    ["ecs-shot", ".ecs-card-shot", ".ecs-panel-shot"],
    ["ecs-tag", ".ecs-card-tagline", ".ecs-panel-tagline"],
    ["ecs-name", ".ecs-card-name", ".ecs-panel-name"],
    ["ecs-plus", ".ecs-plus", ".ecs-plus--close"],
  ];

  type VT = { finished: Promise<void> };
  const startVT = (
    document as Document & { startViewTransition?: (cb: () => void) => VT }
  ).startViewTransition?.bind(document);

  if (!startVT) document.documentElement.classList.add("ecs-no-vt");

  const reduced = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Gốc có thể CHÍNH LÀ phần tử cần tìm (.ecs-card / .ecs-panel) */
  const pick = (root: Element, sel: string): HTMLElement | null =>
    (root.matches(sel) ? root : root.querySelector(sel)) as HTMLElement | null;

  const paint = (root: Element, col: 1 | 2, on: boolean) => {
    for (const pair of PAIRS) {
      const el = pick(root, pair[col]);
      if (el) el.style.viewTransitionName = on ? pair[0] : "";
    }
  };
  const paintCard = (card: Element, on: boolean) => paint(card, 1, on);
  const paintPanel = (panel: Element, on: boolean) => paint(panel, 2, on);

  // Một transition tại một thời điểm. Không có chốt này thì double-click sẽ
  // để `finished` của lượt cũ xoá mất các tên mà lượt mới vừa đặt.
  let current: VT | null = null;

  function morph(before: () => void, swap: () => void, after: () => void) {
    if (!startVT || reduced()) {
      before();
      swap();
      after();
      return;
    }
    before();
    const vt = startVT(swap);
    current = vt;
    vt.finished.finally(() => {
      if (current !== vt) return;
      after();
      current = null;
    });
  }

  const panelOf = (dlg: HTMLDialogElement) =>
    dlg.querySelector(".ecs-panel") as HTMLElement;
  const cardOf = (id: string) =>
    document.querySelector(`.ecs-card[data-product="${id}"]`) as HTMLElement | null;

  function open(card: HTMLElement) {
    const dlg = document.getElementById(
      `ecs-dlg-${card.dataset.product}`,
    ) as HTMLDialogElement | null;
    if (!dlg || dlg.open) return;
    const panel = panelOf(dlg);
    morph(
      () => paintCard(card, true),
      () => {
        paintCard(card, false);
        dlg.showModal();
        paintPanel(panel, true);
      },
      () => paintPanel(panel, false),
    );
  }

  function close(dlg: HTMLDialogElement) {
    if (!dlg.open) return;
    const panel = panelOf(dlg);
    const card = cardOf(dlg.dataset.product ?? "");
    morph(
      () => paintPanel(panel, true),
      () => {
        paintPanel(panel, false);
        dlg.close();
        // <dialog> tự trả focus về nút đã mở nó — NHƯNG chỉ khi nút đó đang
        // được focus lúc showModal() (đúng với chuột thật và Enter bàn phím).
        // Focus lại tường minh để đường nào mở cũng trả focus đúng chỗ.
        if (card) {
          paintCard(card, true);
          card.focus();
        }
      },
      () => card && paintCard(card, false),
    );
  }

  document.querySelectorAll<HTMLElement>(".ecs-card").forEach((card) => {
    card.addEventListener("click", () => open(card));
  });

  document.querySelectorAll<HTMLDialogElement>(".ecs-dialog").forEach((dlg) => {
    // Escape: chặn cái đóng phựt của UA để còn kịp morph ngược
    dlg.addEventListener("cancel", (e) => {
      e.preventDefault();
      close(dlg);
    });
    // Bấm ra ngoài tấm: <dialog> phủ kín khung nhìn nên e.target là chính nó
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close(dlg);
    });
    dlg
      .querySelector("[data-close]")
      ?.addEventListener("click", () => close(dlg));
  });
</script>

<style>
  .ecs-section {
    position: relative;
    isolation: isolate; /* nhốt aurora (z-index:-1) trong section, không lùi sau trang */
    padding: 5rem 0;
  }

  /* ── Nền ĐỒNG BỘ VỚI HERO: quầng xanh + lưới chấm ─────────────
     Dùng lại đúng công thức nền của UmbrellaHero để hero và section này nhìn
     liền mạch: `::before` = hai quầng xanh --primary mềm ở góc (như .uhero-glow),
     `::after` = lưới chấm mờ fade dần về mép (như .uhero-grid). Token → tự đổi
     theme; tĩnh, không backdrop-filter → không giật khi cuộn. */
  .ecs-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        40rem 32rem at 6% 2%,
        hsl(var(--primary) / 0.18),
        transparent 60%
      ),
      radial-gradient(
        42rem 34rem at 96% 104%,
        hsl(var(--primary) / 0.14),
        transparent 62%
      );
  }
  .ecs-section::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Lưới chấm giống hệt .uhero-grid */
    background-image: radial-gradient(
      hsl(var(--foreground) / 0.05) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(circle at 50% 45%, #000, transparent 72%);
    mask-image: radial-gradient(circle at 50% 45%, #000, transparent 72%);
  }
  @media (prefers-reduced-transparency: reduce) {
    .ecs-section::before {
      display: none;
    }
  }

  /* Căn trái, KHÔNG eyebrow: ngân sách eyebrow của trang đã dùng cho hero */
  .ecs-header {
    max-width: 44rem;
    margin: 0 0 2.5rem;
  }

  .ecs-title {
    font-family: "Google Sans", sans-serif;
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    margin: 0 0 0.875rem;
  }

  .ecs-subtitle {
    font-size: var(--fs-lead);
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
    max-width: 65ch;
  }

  /* ── Lưới ────────────────────────────────────────────────── */
  .ecs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
  }

  .ecs-grid > li {
    display: flex;
  }

  /* Ô cuối, nếu rơi vào thế đứng một mình (số sản phẩm LẺ trong lưới 2 cột),
     chiếm luôn cả hàng. Không có nó thì 3 sản phẩm ra "2 + 1 ô rỗng".

     CỐ Ý không dùng `grid-column: auto / -1`. Nghe thì như "giãn tới hết hàng",
     nhưng khi start là `auto` còn end là một đường xác định thì ô chỉ span 1 và
     bị đẩy về sát đường đó: đo được 5 sản phẩm ra 2 + 1 + 2. Phải nói thẳng span.

     Ô rộng gấp đôi thì ảnh cao hơn chút cho cân, nhưng vẫn cố định. */
  .ecs-grid[data-cols="2"] > li:last-child:nth-child(odd) {
    grid-column: span 2;
  }

  .ecs-grid[data-cols="2"] > li:last-child:nth-child(odd) .ecs-card-shot {
    height: 15rem;
  }

  /* ── Thẻ thu gọn ─────────────────────────────────────────── */
  .ecs-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
    padding: 0.75rem;
    text-align: left;
    cursor: pointer;
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: var(--shape-card);
    background: hsl(var(--card));
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .ecs-card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: var(--elev-2);
  }

  .ecs-card:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  /* `display:block` là BẮT BUỘC cho mọi phần tử mang view-transition-name:
     phần tử inline có thể vỡ thành nhiều line box, và khi đó trình duyệt bỏ
     qua cái tên mà không báo gì. Các span dưới đây mặc định là inline. */
  .ecs-card-shot {
    display: block;
    position: relative;
    overflow: hidden;
    /* Chiều cao CỐ ĐỊNH, không aspect-ratio: ở thẻ full-width, một tỉ lệ như
       16/10 cho ra ảnh cao ~410px — thẻ nặng nề, và không còn chênh lệch với
       tấm mở rộng nên cú morph mất phần "wow". Bản gốc 21st cũng cố định
       (h-56 = 224px). object-position:top giữ lại thanh địa chỉ + nav của app. */
    height: 13.5rem;
    border-radius: 0.875rem;
    background: hsl(var(--muted) / 0.5);
  }

  .ecs-card-shot img,
  .ecs-panel-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .ecs-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.375rem;
  }

  .ecs-card-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ecs-card-tagline {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
  }

  .ecs-card-name {
    display: block;
    font-family: "Google Sans", sans-serif;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: hsl(var(--foreground));
  }

  /* ── Nút cộng (thu gọn: trang trí · mở rộng: nút đóng) ────── */
  .ecs-plus {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--shape-pill);
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    color: hsl(var(--foreground) / 0.65);
    transition:
      background 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease;
  }

  .ecs-plus svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ecs-card:hover .ecs-plus {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  .ecs-plus--close {
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
  }

  /* Cùng một glyph, xoay 45° thành dấu ×. Đó là lý do nó morph được. */
  .ecs-plus--close svg {
    transform: rotate(45deg);
  }

  .ecs-plus--close:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }

