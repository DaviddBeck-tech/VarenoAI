---
import { Image } from "astro:assets";
import { getLangFromUrl } from "../i18n/utils";
import { SITE } from "../config/site";
import caseVarenogroup from "../assets/case_study_group.png";
import caseFoodhub from "../assets/case_study_foodhub.png";
import caseDecorx from "../assets/case_study_decorx.png";

interface Props {
  title?: string | null;
  titleHighlight?: string | null;
  description?: string | null;
  badgeLabel?: string | null;
  seeAllText?: string | null;
  seeAllUrl?: string | null;
  caseStudies?:
    | {
        id?: string;
        tabLabel?: string | null;
        quote?: string | null;
        author?: string | null;
        role?: string | null;
        image?: string | null;
        linkText?: string | null;
        linkUrl?: string | null;
      }[]
    | null;
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";

const {
  title,
  titleHighlight,
  description,
  badgeLabel,
  seeAllText,
  seeAllUrl,
  caseStudies,
} = Astro.props;

const defaultCaseStudies = isEn
  ? [
      {
        id: "large",
        tabLabel: "Large Business",
        quote:
          "“Automated over 80% of repetitive customer conversations, helping our support team focus on complex cases and raising CSAT to 95%.”",
        author: "Nguyen Minh Thu",
        role: `Head of Customer Service, ${SITE.brandName} Group`,
        image: caseVarenogroup,
        linkText: "Read case study",
        linkUrl: "#",
      },
      {
        id: "medium",
        tabLabel: "Medium Business",
        quote:
          "“Just 2 weeks after deployment, the chat conversion rate increased by nearly 40% without hiring additional staff.”",
        author: "Tran Quoc Bao",
        role: "Founder, FoodHub",
        image: caseFoodhub,
        linkText: "Read case study",
        linkUrl: "#",
      },
      {
        id: "small",
        tabLabel: "Small Business",
        quote:
          `“No more missed customer messages at night. ${SITE.brandName} automatically consults and stores lead information with extreme accuracy.”`,
        author: "Le Hoai Nam",
        role: "Store Owner, DecorX",
        image: caseDecorx,
        linkText: "Read case study",
        linkUrl: "#",
      },
    ]
  : [
      {
        id: "large",
        tabLabel: "Doanh nghiệp lớn",
        quote:
          "“Tự động hóa hơn 80% cuộc hội thoại lặp đi lặp lại của khách hàng, giúp đội ngũ support tập trung vào các case phức tạp và nâng cao CSAT lên 95%.”",
        author: "Nguyễn Minh Thư",
        role: `Trưởng bộ phận CSKH, ${SITE.brandName} Group`,
        image: caseVarenogroup,
        linkText: "Đọc case study",
        linkUrl: "#",
      },
      {
        id: "medium",
        tabLabel: "Doanh nghiệp vừa",
        quote:
          "“Chỉ sau 2 tuần triển khai, tỉ lệ chốt đơn qua chat tăng gần 40% mà không cần thêm nhân sự.”",
        author: "Trần Quốc Bảo",
        role: "Founder, FoodHub",
        image: caseFoodhub,
        linkText: "Đọc case study",
        linkUrl: "#",
      },
      {
        id: "small",
        tabLabel: "Doanh nghiệp nhỏ",
        quote:
          `“Không còn bỏ lỡ tin nhắn khách hàng vào ban đêm. ${SITE.brandName} tự động tư vấn và lưu thông tin lead cực kỳ chính xác.”`,
        author: "Lê Hoài Nam",
        role: "Chủ cửa hàng, DecorX",
        image: caseDecorx,
        linkText: "Đọc case study",
        linkUrl: "#",
      },
    ];

// Use ACF case studies (case1..3) when provided; otherwise fall back to defaults.
const defaultIds = ["large", "medium", "small"];
const cases =
  caseStudies && caseStudies.length > 0
    ? caseStudies.map((c, i) => ({
        id: c.id || defaultIds[i] || `case-${i}`,
        tabLabel: c.tabLabel || `Case ${i + 1}`,
        quote: c.quote || "",
        author: c.author || "",
        role: c.role || "",
        image: c.image || "",
        linkText: c.linkText || (isEn ? "Read case study" : "Đọc case study"),
        linkUrl: c.linkUrl || "#",
      }))
    : defaultCaseStudies;
---

<section class="ps-section" id="case-studies">
  <div class="ps-container">
    <!-- Header -->
    <div class="ps-header">
      <div class="ps-header-left">
        <span class="ps-badge">{badgeLabel || "CASE STUDIES"}</span>
        <h2 class="ps-title">
          {title || (isEn ? "Impressive results for businesses of " : "Kết quả ấn tượng cho doanh nghiệp ")}
          <span class="ps-title-hl">{titleHighlight || (isEn ? "all sizes" : "mọi quy mô")}</span>
          <span class="ps-dot">.</span>
        </h2>
      </div>

      <div class="ps-header-right">
        <span class="ps-titlesub-right">{seeAllText || (isEn ? "See all case studies" : "Giải pháp cho nhu cầu của bạn")}</span>
        <p class="ps-subtitle">
          {description || (isEn
            ? `From small shops to 500+ store chains — ${SITE.brandName} scales to your needs.`
            : `Từ shop nhỏ đến chuỗi 500+ cửa hàng — ${SITE.brandName} mở rộng theo nhu cầu của bạn.`)}
        </p>
      </div>
    </div>

    <!-- Tabs Nav -->
    <div class="ps-tabs-nav-wrapper">
      <div class="ps-tabs-nav" id="psTabsNav">
        {cases.map((study, idx) => (
          <button
            class={`ps-tab-btn ${idx === 1 ? "ps-tab-btn--active" : ""}`}
            data-target={study.id}
          >
            {study.tabLabel}
          </button>
        ))}
        <!-- Moving Underline -->
        <div class="ps-tab-underline" id="psTabUnderline"></div>
      </div>
    </div>

    <!-- Case Studies Content Stack -->
    <div class="ps-content-viewport">
      {cases.map((study, idx) => (
        <div
          class={`ps-case-card ${idx === 1 ? "ps-case-card--active" : ""}`}
          id={`case-${study.id}`}
        >
          <!-- Left: Image -->
          <div class="ps-case-img-wrap">
            {typeof study.image === "string" ? (
              study.image && (
                <img
                  src={study.image}
                  alt={study.author}
                  class="ps-case-img"
                  width="512"
                  height="512"
                  loading="lazy"
                  decoding="async"
                />
              )
            ) : (
              <Image
                src={study.image}
                alt={study.author}
                class="ps-case-img"
                width={512}
                height={512}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <!-- Right: Quote Info -->
          <div class="ps-case-info">
            <blockquote class="ps-case-quote">
              {study.quote}
            </blockquote>

            <div class="ps-case-meta">
              <h4 class="ps-case-author">{study.author}</h4>
              <p class="ps-case-role">{study.role}</p>
            </div>

            {/* <a href={study.linkUrl} class="ps-case-link">
              <span>{study.linkText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ps-link-arrow"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a> */}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initPsShowcase() {
    const nav = document.getElementById('psTabsNav');
    const underline = document.getElementById('psTabUnderline');
    if (!nav || !underline) return;

    const buttons = Array.from(nav.querySelectorAll('.ps-tab-btn')) as HTMLButtonElement[];
    const cards = Array.from(document.querySelectorAll('.ps-case-card')) as HTMLElement[];

    function updateUnderline(activeBtn: HTMLButtonElement) {
      const navRect = nav!.getBoundingClientRect();
      const btnRect = activeBtn.getBoundingClientRect();
      underline!.style.width = `${btnRect.width}px`;
      underline!.style.left = `${btnRect.left - navRect.left + nav!.scrollLeft}px`;
    }

    function setActiveTab(btn: HTMLButtonElement) {
      buttons.forEach(b => b.classList.remove('ps-tab-btn--active'));
      btn.classList.add('ps-tab-btn--active');
      updateUnderline(btn);

      const targetId = btn.getAttribute('data-target');
      cards.forEach(card => {
        if (card.id === `case-${targetId}`) {
          card.classList.add('ps-case-card--active');
        } else {
          card.classList.remove('ps-case-card--active');
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => setActiveTab(btn));
    });

    /* Find initial active button */
    const initialActive = buttons.find(b => b.classList.contains('ps-tab-btn--active')) || buttons[0];
    if (initialActive) {
      /* Wait a tiny bit for layout styling to calculate correctly */
      setTimeout(() => updateUnderline(initialActive), 100);
    }

    window.addEventListener('resize', () => {
      const active = buttons.find(b => b.classList.contains('ps-tab-btn--active'));
      if (active) updateUnderline(active);
    });

    /* Update underline when tab container scrolls on mobile */
    nav.addEventListener('scroll', () => {
      const active = buttons.find(b => b.classList.contains('ps-tab-btn--active'));
      if (active) updateUnderline(active);
    });
  }

  /* Support Astro page transitions */
  document.addEventListener('DOMContentLoaded', initPsShowcase);
  document.addEventListener('astro:page-load', initPsShowcase);
</script>

<style>
  .ps-section {
    padding: 7rem 0;
    position: relative;
    background: transparent;
  }

  .ps-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Header ──────────────────────────────────────────────── */
  .ps-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 992px) {
    .ps-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 4rem;
    }
  }

  .ps-header-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 650px;
  }

  .ps-badge {
    font-family: var(--font-body), sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.05em;
  }

  .ps-title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    color: hsl(var(--foreground));
    margin: 0;
    letter-spacing: -0.02em;
  }

  .ps-title-hl { color: hsl(var(--primary)); }
  .ps-dot      { color: hsl(var(--primary)); }

  .ps-header-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: 480px;
  }

  @media (min-width: 992px) {
    .ps-header-right {
      align-items: flex-end;
      text-align: right;
    }
  }

  .ps-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body), sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: hsl(var(--primary));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ps-all-link:hover {
    color: hsl(var(--primary) / 0.85);
  }

  .ps-all-link:hover .ps-arrow {
    transform: translateX(3px);
  }

  .ps-arrow {
    transition: transform 0.2s ease;
  }

  .ps-titlesub-right {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 800;
    line-height: 1.25;
    color: hsl(var(--foreground));
    letter-spacing: -0.01em;
  }

  .ps-subtitle {
    font-family: var(--font-body), sans-serif;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
    margin: 0;
  }

  /* ── Tabs Navigation ─────────────────────────────────────── */
  .ps-tabs-nav-wrapper {
    position: relative;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
    margin-bottom: 4rem;
  }

  .ps-tabs-nav {
    display: flex;
    gap: 2.5rem;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    position: relative;
    padding-bottom: 0.75rem;
  }

  .ps-tabs-nav::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .ps-tab-btn {
    font-family: var(--font-body), sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    padding: 0;
    transition: color 0.2s ease;
  }

  .ps-tab-btn:hover {
    color: hsl(var(--foreground));
  }

  .ps-tab-btn--active {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .ps-tab-underline {
    position: absolute;
    bottom: -1px;
    height: 2px;
    background: hsl(var(--primary));
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Case Studies Content Stack ──────────────────────────── */
  .ps-content-viewport {
    position: relative;
    min-height: 380px;
  }

  .ps-case-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease,
      transform 0.4s ease;
  }

  .ps-case-card--active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .ps-case-card {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
    }
  }

  /* Left: Image */
  .ps-case-img-wrap {
    width: 85%;
    aspect-ratio: 1 / 1;
    border-radius: 1.5rem;
    overflow: hidden;
    background: hsl(var(--muted) / 0.3);
    border: 1px solid hsl(var(--border) / 0.5);
  }

  .ps-case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right: Info */
  .ps-case-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    text-align: left;
  }

  .ps-case-quote {
    font-family: var(--font-display), serif;
    font-size: clamp(1.375rem, 2.2vw, 2rem);
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
    margin: 0;
    letter-spacing: -0.01em;
  }

  .ps-case-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ps-case-author {
    font-family: var(--font-body), sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .ps-case-role {
    font-family: var(--font-body), sans-serif;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  .ps-case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body), sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: hsl(var(--primary));
    text-decoration: none;
    width: fit-content;
    transition: gap 0.2s ease;
  }

  .ps-case-link:hover {
    gap: 0.5rem;
  }

  .ps-case-link:hover .ps-link-arrow {
    transform: translateX(2px);
  }

  .ps-link-arrow {
    transition: transform 0.2s ease;
  }

  @media (max-width: 768px) {
    .ps-section {
      padding: 3.5rem 0;
    }

    /* Full-width image when the card is stacked into a single column */
    .ps-case-img-wrap {
      width: 100%;
    }

    /* Tabs nav: shrink so all 3 tabs fit without horizontal scroll */
    .ps-tabs-nav {
      gap: 1rem;
      justify-content: space-between;
    }

    .ps-tab-btn {
      font-size: 0.8125rem;
      white-space: normal;
      text-align: center;
      flex: 1 1 0;
      min-width: 0;
    }
  }

  @media (max-width: 400px) {
    .ps-tabs-nav {
      gap: 0.5rem;
    }

    .ps-tab-btn {
      font-size: 0.6875rem;
    }
  }
</style>
