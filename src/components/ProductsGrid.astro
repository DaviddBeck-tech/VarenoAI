---
// Lưới thẻ sản phẩm — đọc từ src/config/products.ts.
// Dùng trên trang chủ umbrella VÀ trang /services/.
// Thêm sản phẩm mới = thêm 1 object vào products.ts, không phải sửa file này.
import ProductIcon from "./ProductIcon.astro";
import { navProducts, productPath } from "../config/products";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

interface Props {
  badge?: string | null;
  title?: string | null;
  subtitle?: string | null;
  showStatusBadge?: boolean;
}

const { badge, title, subtitle, showStatusBadge = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const products = navProducts();
---

<section class="pg-section">
  <div class="container">
    {
      (badge || title || subtitle) && (
        <header class="pg-header">
          {badge && <span class="pg-badge-top">{badge}</span>}
          {title && <h2 class="pg-title">{title}</h2>}
          {subtitle && <p class="pg-subtitle">{subtitle}</p>}
        </header>
      )
    }

    <div class="pg-grid">
      {
        products.map((p) => (
          <a
            href={translatePath(productPath(p))}
            class="pg-card"
            data-status={p.status}
          >
            <span class="pg-icon">
              <ProductIcon name={p.icon} size={26} />
            </span>

            <h3 class="pg-name">
              {p.name}
              {showStatusBadge && p.status === "coming-soon" && (
                <em class="pg-soon">{t("products.comingSoon")}</em>
              )}
            </h3>

            <p class="pg-tagline">{p.tagline[lang]}</p>
            <p class="pg-desc">{p.description[lang]}</p>

            <span class="pg-link">
              {t("products.learnMore")}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pg-section {
    padding: 5rem 0;
  }

  .pg-header {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 3rem;
  }

  .pg-badge-top {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .pg-title {
    font-family: "Google Sans", sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin: 0 0 0.875rem;
  }

  .pg-subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  /* ── Grid ─────────────────────────────────────── */
  .pg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }

  .pg-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 2rem;
    border-radius: var(--shape-card);
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--card));
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Một màu thương hiệu duy nhất cho mọi sản phẩm; phân biệt bằng icon và
     trạng thái, không bằng hue. Xem chú thích trong src/config/products.ts. */
  .pg-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: hsl(var(--primary));
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pg-card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: var(--elev-2);
  }

  .pg-card:hover::before {
    opacity: 1;
  }

  .pg-card:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  .pg-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--shape-btn);
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    margin-bottom: 0.5rem;
  }

  /* Chưa ra mắt: tắt màu thương hiệu để sản phẩm đang chạy nổi lên trước */
  .pg-card[data-status="coming-soon"] .pg-icon {
    color: hsl(var(--muted-foreground));
    background: hsl(var(--muted));
  }

  .pg-card[data-status="coming-soon"] .pg-tagline {
    color: hsl(var(--muted-foreground));
  }

  .pg-name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: "Google Sans", sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .pg-soon {
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border) / 0.8);
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
  }

  .pg-tagline {
    font-size: 0.9375rem;
    font-weight: 500;
    color: hsl(var(--primary));
    margin: 0;
  }

  .pg-desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
    flex: 1;
  }

  .pg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .pg-link svg {
    transition: transform 0.25s ease;
  }

  .pg-card:hover .pg-link svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pg-card,
    .pg-link svg {
      transition: none;
    }
    .pg-card:hover {
      transform: none;
    }
    .pg-card:hover .pg-link svg {
      transform: none;
    }
  }
</style>
