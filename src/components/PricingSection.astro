---
interface Props {
  title?: string | null;
  titleHighlight?: string | null;
  description?: string | null;
  pricingPlans?: {
    planName: string;
    price: string;
    period: string;
    priceYearly?: string;
    yearlyDescription?: string;
    discountBadge?: string;
    desc?: string;
    features: { featureText: string }[] | string[];
    isHighlighted: boolean;
    ctaText: string;
    ctaLink: string;
  }[] | null;
}

const {
  title,
  titleHighlight,
  description,
  pricingPlans,
} = Astro.props;

type PricingPlan = NonNullable<Props['pricingPlans']>[number];

const defaultPlans: PricingPlan[] = [
  {
    planName: "Free",
    price: "$0",
    period: "forever",
    desc: "Perfect for trying things out",
    features: ["50 queries/month", "5 URLs per session", "Basic chat history", "Community support"],
    ctaText: "Get Started Free",
    ctaLink: "#",
    isHighlighted: false,
  },
  {
    planName: "Pro",
    price: "$19",
    period: "/month",
    desc: "For power users and indie devs",
    features: ["Unlimited queries", "Unlimited URLs", "Full conversation history", "Priority support", "Export to markdown", "API access"],
    ctaText: "Start Pro Trial",
    ctaLink: "#",
    isHighlighted: true,
  },
  {
    planName: "Team",
    price: "$49",
    period: "/month",
    desc: "For teams that ship fast",
    features: ["Everything in Pro", "5 team members", "Shared workspaces", "Admin dashboard", "SSO & SAML", "Dedicated support"],
    ctaText: "Contact Sales",
    ctaLink: "#",
    isHighlighted: false,
  },
];

const displayPlans = pricingPlans && pricingPlans.length > 0 ? pricingPlans : defaultPlans;
---

<section id="pricing" class="relative py-14 md:py-32 scroll-animate">
  <div class="container">
    <div class="text-center mb-16">
      {title ? (
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight mb-4">
          {title} {titleHighlight && <span class="gradient-text">{titleHighlight}</span>}
        </h2>
      ) : (
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight mb-4">
          Simple, transparent <span class="gradient-text">pricing</span>
        </h2>
      )}
      <p class="text-muted-foreground text-lg">{description || "No hidden fees. Cancel anytime."}</p>
    </div>

    <div class="flex justify-center items-center gap-4 mb-12">
      <span class="text-sm font-semibold text-foreground transition-colors" id="label-monthly">Monthly</span>
      <button 
        type="button" 
        id="pricing-toggle-btn" 
        class="relative inline-flex h-7 w-14 items-center rounded-full bg-secondary-foreground/20 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-background" 
        role="switch"
        aria-checked="false"
      >
        <span class="sr-only">Toggle Yearly Pricing</span>
        <span class="translate-x-1 inline-block h-5 w-5 transform rounded-full bg-background shadow transition-transform duration-200 ease-in-out" id="pricing-toggle-knob"></span>
      </button>
      <span class="text-sm font-medium text-muted-foreground transition-colors" id="label-yearly">Yearly</span>
    </div>

    <div id="pricing-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-2 max-w-7xl mx-auto">
      {displayPlans.map((plan) => {
        // Normalize features: GraphQL gives objects {featureText}, default data gives strings
        const normalizedFeatures = plan.features?.length > 0 
           ? plan.features.map((f: any) => typeof f === 'object' ? f.featureText : f)
           : [];

        return (
          <div
            class:list={[
              "relative rounded-2xl p-5 lg:p-3 xl:p-7 flex flex-col h-full",
              plan.isHighlighted
                ? "glass-card border-primary/30 shadow-[0_0_40px_-10px_hsl(var(--primary)/0.2)]"
                : "glass-card"
            ]}
          >
            {plan.isHighlighted && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 xl:px-4 py-1 rounded-full bg-primary text-primary-foreground text-[10px] xl:text-xs font-semibold whitespace-nowrap">
                Most Popular
              </div>
            )}

            <h3 class="font-display text-lg font-semibold mb-1 flex items-center gap-2">
              {plan.planName}
              {plan.discountBadge && (
                <span class="yearly-element-inline hidden items-center rounded-full bg-green-100 dark:bg-green-900/40 px-2.5 py-0.5 text-[10px] font-bold text-green-700 dark:text-green-400 uppercase tracking-wider">
                  {plan.discountBadge}
                </span>
              )}
            </h3>
            {plan.desc && <p class="text-muted-foreground text-sm mb-5">{plan.desc}</p>}
            
            <div class={`mb-6 ${!plan.desc ? 'mt-3' : ''}`}>
              <!-- Monthly Block -->
              <div class="monthly-element block">
                <span class="font-display text-xl xl:text-2xl font-bold">{plan.price}</span>
                <span class="text-muted-foreground text-xs xl:text-sm ml-1 whitespace-nowrap">{plan.period}</span>
              </div>
              
              <!-- Yearly Block -->
              <div class="yearly-element hidden">
                <span class="font-display text-xl xl:text-2xl font-bold">{plan.priceYearly || plan.price}</span>
                <span class="text-muted-foreground text-xs xl:text-sm ml-1 whitespace-nowrap">{plan.yearlyDescription || '/year'}</span>
              </div>
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {normalizedFeatures.map((f: string) => (
                <li class="flex items-center gap-2.5 text-[13px]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  <span class="text-foreground/80">{f}</span>
                </li>
              ))}
            </ul>

            {plan.isHighlighted ? (
              <a href={plan.ctaLink || "#"} target="_blank" rel="noopener noreferrer" class="btn-hero text-center w-full px-2 xl:px-4 text-xs xl:text-base whitespace-nowrap">
                {plan.ctaText}
              </a>
            ) : (
              <a href={plan.ctaLink || "#"} target="_blank" rel="noopener noreferrer" class="btn-outline text-center w-full px-2 xl:px-4 text-xs xl:text-base whitespace-nowrap">
                {plan.ctaText}
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Highlight background */
  #pricing {
    /* Nền wash một sắc thương hiệu (#2463eb), không còn tím */
    background: linear-gradient(
      180deg,
      hsl(var(--background)) 0%,
      hsl(var(--primary) / 0.05) 45%,
      hsl(var(--primary) / 0.1) 100%
    );
  }

  :global(.dark) #pricing {
    background: linear-gradient(
      180deg,
      hsl(var(--background)) 0%,
      hsl(var(--primary) / 0.07) 45%,
      hsl(var(--primary) / 0.14) 100%
    );
  }

  /* Solid (non-blur) cards so they stand out over the gradient */
  #pricing :global(.glass-card) {
    background-color: hsl(var(--card));
    backdrop-filter: none;
  }

  /* CSS Toggle Logic */
  #pricing-container.is-yearly .monthly-element { display: none !important; }
  #pricing-container.is-yearly .yearly-element { display: block !important; }
  #pricing-container.is-yearly .yearly-element-inline { display: inline-flex !important; }
</style>

<script>
  const setupPricingToggle = () => {
    const btn = document.getElementById('pricing-toggle-btn');
    const knob = document.getElementById('pricing-toggle-knob');
    const container = document.getElementById('pricing-container');
    const labelMonthly = document.getElementById('label-monthly');
    const labelYearly = document.getElementById('label-yearly');

    if (!btn || !container) return;

    btn.addEventListener('click', () => {
      const isYearly = container.classList.toggle('is-yearly');
      
      if (isYearly) {
        btn.setAttribute('aria-checked', 'true');
        btn.classList.replace('bg-secondary-foreground/20', 'bg-primary');
        knob?.classList.replace('translate-x-1', 'translate-x-8');
        labelMonthly?.classList.replace('font-semibold', 'font-medium');
        labelMonthly?.classList.replace('text-foreground', 'text-muted-foreground');
        labelYearly?.classList.replace('font-medium', 'font-semibold');
        labelYearly?.classList.replace('text-muted-foreground', 'text-foreground');
      } else {
        btn.setAttribute('aria-checked', 'false');
        btn.classList.replace('bg-primary', 'bg-secondary-foreground/20');
        knob?.classList.replace('translate-x-8', 'translate-x-1');
        labelMonthly?.classList.replace('font-medium', 'font-semibold');
        labelMonthly?.classList.replace('text-muted-foreground', 'text-foreground');
        labelYearly?.classList.replace('font-semibold', 'font-medium');
        labelYearly?.classList.replace('text-foreground', 'text-muted-foreground');
      }
    });
  };

  setupPricingToggle();
  document.addEventListener('astro:page-load', setupPricingToggle);
</script>
