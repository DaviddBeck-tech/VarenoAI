---
// Logo lockup mới (PNG); hai bản đổi theo theme vì card nền theo --card — xem
// chú thích ở Header.astro.
import logoLight from "../assets/logo-vareno-ai.png";
import logoDark from "../assets/logo-vareno-ai-dark.png";

interface Props {
  title?: string | null;
  description?: string | null;
  linkText?: string | null;
  linkUrl?: string | null;
}

const {
  title = "We value your privacy and never store your data without permission",
  description = "Your conversations and website content are processed securely.\nWe never use your data to train AI models.\nYour privacy is our top priority.",
  linkText = "Learn more about our privacy policy",
  linkUrl = "#",
} = Astro.props;
---

<section class="privacy-section">
  <div class="privacy-container">
    <!-- Left Column: Content -->
    <div class="privacy-content">
      <h2 class="privacy-title">
        {title}
      </h2>
      <p class="privacy-description">
        {description}
      </p>
      {
        linkText && (
          <a href={linkUrl || "#"} class="privacy-link">
            <span>{linkText}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="privacy-link-arrow"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        )
      }
    </div>

    <!-- Right Column: Orbital Diagram -->
    <div class="privacy-orbital-wrap">
      <div class="orbital-diagram">
        <!-- Dashed Outer Ring -->
        <div class="orbit-ring orbit-ring--outer"></div>
        <!-- Dashed Inner Ring -->
        <div class="orbit-ring orbit-ring--inner"></div>

        <!-- Center Node (Logo SVG) -->
        <div class="center-node">
          <div class="center-node-glow"></div>
          <div class="center-node-card">
            <div class="center-brand-logo-wrap">
              <img
                class="center-brand-logo center-brand-logo--light"
                src={logoLight.src}
                width={logoLight.width}
                height={logoLight.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <img
                class="center-brand-logo center-brand-logo--dark"
                src={logoDark.src}
                width={logoDark.width}
                height={logoDark.height}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Orbiting Icons: giữ nguyên các logo tích hợp hiện tại -->
        <div class="orbit-track orbit-track--inner">
          <div class="orbit-node" style="--angle: -90deg;">
            <div class="node-inner bg-[#0068FF]/10 border-[#0068FF]/30">
              <span class="text-[10px] font-bold text-[#0068FF] tracking-tight">Zalo</span>
            </div>
          </div>

          <div class="orbit-node" style="--angle: 0deg;">
            <div class="node-inner bg-[#1877F2]/10 border-[#1877F2]/30">
              <img src="https://cdn.simpleicons.org/facebook/1877F2" alt="Facebook" class="w-6 h-6" loading="lazy" />
            </div>
          </div>

          <div class="orbit-node" style="--angle: 90deg;">
            <div class="node-inner bg-[#26A5E4]/10 border-[#26A5E4]/30">
              <img src="https://cdn.simpleicons.org/telegram/26A5E4" alt="Telegram" class="w-6 h-6" loading="lazy" />
            </div>
          </div>

          <div class="orbit-node" style="--angle: 180deg;">
            <div class="node-inner bg-[#0084FF]/10 border-[#0084FF]/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="#0084FF" aria-label="Messenger" role="img">
                <path d="M12 2C6.477 2 2 6.145 2 11.259c0 2.873 1.357 5.44 3.484 7.148V22l3.184-1.75c.85.236 1.75.363 2.684.363 5.523 0 10-4.145 10-9.259C21.352 6.145 17.523 2 12 2zm.992 12.469l-2.54-2.708-4.956 2.708 5.451-5.787 2.602 2.708 4.893-2.708-5.45 5.787z"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="orbit-track orbit-track--outer">
          <div class="orbit-node" style="--angle: -135deg;">
            <div class="node-inner bg-[#FF4F00]/10 border-[#FF4F00]/30">
              <img src="https://cdn.simpleicons.org/zapier/FF4F00" alt="Zapier" class="w-6 h-6" loading="lazy" />
            </div>
          </div>

          <div class="orbit-node" style="--angle: -45deg;">
            <div class="node-inner bg-[#21759B]/10 border-[#21759B]/30">
              <img src="https://cdn.simpleicons.org/wordpress/21759B" alt="WordPress" class="w-6 h-6" loading="lazy" />
            </div>
          </div>

          <div class="orbit-node" style="--angle: 45deg;">
            <div class="node-inner bg-[#7AB55C]/10 border-[#7AB55C]/30">
              <img src="https://cdn.simpleicons.org/shopify/7AB55C" alt="Shopify" class="w-6 h-6" loading="lazy" />
            </div>
          </div>

          <div class="orbit-node" style="--angle: 135deg;">
            <div class="node-inner bg-[#03A9F4]/10 border-[#03A9F4]/30">
              <img src="https://cdn.simpleicons.org/homeassistant/03A9F4" alt="Home Assistant" class="w-6 h-6" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy-section {
    padding: 7rem 0;
    position: relative;
    overflow: hidden;
  }

  .privacy-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .privacy-container {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 6rem;
    }

    .privacy-orbital-wrap {
      justify-content: flex-end;
      transform: translateX(16rem);
    }
  }

  /* Left Column: Content */
  .privacy-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 600px;
    text-align: left;
  }

  .privacy-title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    color: hsl(var(--foreground));
    margin: 0;
    letter-spacing: -0.02em;
  }

  .privacy-description {
    font-family: var(--font-body), sans-serif;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
    margin: 0;
    white-space: pre-line;
  }

  .privacy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body), sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: hsl(var(--primary));
    text-decoration: none;
    width: fit-content;
    transition: all 0.2s ease;
  }

  .privacy-link:hover {
    color: hsl(var(--primary) / 0.85);
  }

  .privacy-link:hover .privacy-link-arrow {
    transform: translateX(3px);
  }

  .privacy-link-arrow {
    transition: transform 0.2s ease;
  }

  /* Right Column: Orbital Diagram */
  .privacy-orbital-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .orbital-diagram {
    position: relative;
    width: min(31rem, 92vw);
    aspect-ratio: 1;
    flex-shrink: 0;
    isolation: isolate;
  }

  .orbital-diagram::before {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      hsl(var(--primary) / 0.09) 0%,
      hsl(var(--primary) / 0.025) 38%,
      transparent 70%
    );
    filter: blur(22px);
    pointer-events: none;
  }

  /* Orbit Rings */
  .orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px dashed hsl(var(--foreground) / 0.11);
  }

  .orbit-ring--inner {
    width: 70%;
    height: 70%;
  }

  .orbit-ring--outer {
    width: 100%;
    height: 100%;
  }

  /* Center Node */
  .center-node {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  .center-node-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 13rem;
    height: 13rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      hsl(var(--primary) / 0.18) 0%,
      transparent 68%
    );
    filter: blur(12px);
    animation: center-glow 4s ease-in-out infinite alternate;
  }

  .center-node-card {
    position: relative;
    width: clamp(8rem, 27vw, 10rem);
    height: clamp(8rem, 27vw, 10rem);
    background: hsl(var(--card) / 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 2px solid hsl(var(--primary) / 0.38);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 22px 55px -20px hsl(var(--primary) / 0.42),
      inset 0 1px 0 hsl(var(--background) / 0.85);
    animation: float-center 4s ease-in-out infinite;
  }

  .center-brand-logo-wrap {
    width: 68%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-brand-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .center-brand-logo--dark {
    display: none;
  }

  :global(html.dark) .center-brand-logo--light {
    display: none;
  }

  :global(html.dark) .center-brand-logo--dark {
    display: block;
  }

  /* Orbit tracks rotate as a group; nodes counter-rotate to keep logos upright. */
  .orbit-track {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: orbit-spin 24s linear infinite;
  }

  .orbit-track--inner {
    width: 70%;
    height: 70%;
    animation-duration: 22s;
  }

  .orbit-track--outer {
    width: 100%;
    height: 100%;
    animation-duration: 34s;
    animation-direction: reverse;
  }

  .orbit-node {
    position: absolute;
    top: 50%;
    left: 50%;
    transform:
      translate(-50%, -50%)
      rotate(var(--angle))
      translateX(calc(var(--orbit-radius) / 2))
      rotate(calc(-1 * var(--angle)));
    z-index: 5;
  }

  .orbit-track--inner .orbit-node {
    --orbit-radius: calc(min(31rem, 92vw) * 0.70);
  }

  .orbit-track--outer .orbit-node {
    --orbit-radius: calc(min(31rem, 92vw) * 1);
  }

  .orbit-track--inner .node-inner {
    animation: logo-counter-spin 22s linear infinite both;
  }

  .orbit-track--outer .node-inner {
    animation: logo-counter-spin-reverse 34s linear infinite both;
  }

  .node-inner {
    width: clamp(3.25rem, 11vw, 4rem);
    height: clamp(3.25rem, 11vw, 4rem);
    transform: rotate(0deg);
    border-radius: 50%;
    background: hsl(var(--card) / 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid hsl(var(--border) / 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 12px 30px -16px hsl(var(--foreground) / 0.38),
      inset 0 1px 0 hsl(var(--background) / 0.9);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .orbit-node:hover .node-inner {
    transform: scale(1.08);
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: 0 16px 34px -15px hsl(var(--primary) / 0.38);
  }

  /* Animations */
  @keyframes orbit-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes logo-counter-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  @keyframes logo-counter-spin-reverse {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes float-center {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes center-glow {
    0% {
      transform: translate(-50%, -50%) scale(0.95);
      opacity: 0.75;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.08);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .privacy-section {
      padding: 3.5rem 0;
    }

    .privacy-container {
      gap: 2.5rem;
    }
  }

  @media (max-width: 420px) {
    .privacy-container {
      padding-inline: 1rem;
    }

    .orbital-diagram {
      width: min(27rem, 108vw);
      margin-inline: -4vw;
    }

    .orbit-track--inner .orbit-node {
      --orbit-radius: calc(min(27rem, 108vw) * 0.70);
    }

    .orbit-track--outer .orbit-node {
      --orbit-radius: calc(min(27rem, 108vw) * 1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-track,
    .orbit-node,
    .node-inner,
    .center-node-card,
    .center-node-glow {
      animation: none;
    }

    .node-inner {
      transform: rotate(0deg);
    }
  }
</style>
