---
// 3 bài viết mới nhất — dùng lại PostCard. Trang công ty thường có mục này,
// product page thì không. Nhận `posts` từ trang (trang lo fetch + try/catch),
// nên khi chưa có WordPress sẽ hiện empty state thay vì vỡ.
import PostCard from "./PostCard.astro";
import type { WPPost } from "../lib/wordpress";

interface Props {
  badge?: string | null;
  title?: string | null;
  titleHighlight?: string | null;
  subtitle?: string | null;
  posts: WPPost[];
  basePath?: string;
  viewAllHref: string;
  viewAllLabel: string;
  emptyText?: string;
}

const {
  badge,
  title,
  titleHighlight,
  subtitle,
  posts,
  basePath = "/blog",
  viewAllHref,
  viewAllLabel,
  emptyText = "Sắp có bài viết mới.",
} = Astro.props;

const items = (posts ?? []).slice(0, 3);
---

<section class="news-section">
  <div class="container">
    <header class="news-header">
      <div class="news-head-text">
        {badge && <span class="news-badge">{badge}</span>}
        {
          title && (
            <h2 class="news-title">
              {title}
              {titleHighlight && <span class="news-hl">{titleHighlight}</span>}
            </h2>
          )
        }
        {subtitle && <p class="news-subtitle">{subtitle}</p>}
      </div>

      <a href={viewAllHref} class="news-viewall">
        {viewAllLabel}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </header>

    {
      items.length > 0 ? (
        <div class="news-grid">
          {items.map((post) => (
            <PostCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              date={post.date}
              imageUrl={post.featuredImage?.node?.sourceUrl}
              imageAlt={post.featuredImage?.node?.altText}
              category={post.categories?.nodes?.[0]?.name}
              basePath={basePath}
            />
          ))}
        </div>
      ) : (
        <div class="news-empty">
          <p>{emptyText}</p>
          <a href={viewAllHref} class="news-empty-link">
            {viewAllLabel}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .news-section {
    padding: 5rem 0;
  }

  .news-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .news-head-text {
    max-width: 42rem;
  }

  .news-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .news-title {
    font-family: "Google Sans", sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin: 0 0 0.625rem;
  }

  .news-hl {
    background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--accent)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .news-subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  .news-viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: hsl(var(--primary));
    text-decoration: none;
    padding-bottom: 0.375rem;
  }

  .news-viewall svg {
    transition: transform 0.2s ease;
  }
  .news-viewall:hover svg {
    transform: translateX(3px);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }

  .news-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 3.5rem 2rem;
    border-radius: 1.25rem;
    border: 1px dashed hsl(var(--border));
    background: hsl(var(--muted) / 0.3);
  }

  .news-empty p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9375rem;
  }

  .news-empty-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .news-empty-link:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .news-viewall:hover svg {
      transform: none;
    }
  }
</style>
