---
import { Image } from 'astro:assets';
import appMockup from "../assets/app-mockup.png";
import { SITE } from "../config/site";

interface Props {
  imageUrl?: string;
  imageAlt?: string;
}

const {
  imageUrl,
  imageAlt = `${SITE.brandName} App Interface`,
} = Astro.props;

// Fallback về ảnh tĩnh (src/assets — được Astro tối ưu) nếu WP chưa có ảnh
const src = imageUrl || appMockup;
---

<div class="relative max-w-5xl mx-auto">
  <!-- Glow behind -->
  <div
    class="absolute -inset-4 bg-gradient-to-r from-primary/20 via-accent/10 to-primary/20 rounded-3xl blur-2xl opacity-60"
  >
  </div>

  <div
    class="relative rounded-2xl overflow-hidden border border-foreground/[0.08] shadow-2xl bg-muted/20"
  >
    {typeof src === "string" ? (
      <Image
        src={src}
        width={1920}
        height={1080}
        format="webp"
        alt={imageAlt}
        class="w-full h-auto block"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        width={1920}
        format="webp"
        alt={imageAlt}
        class="w-full h-auto block"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </div>
</div>
