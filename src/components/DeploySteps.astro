---
// ── TRIỂN KHAI TRONG VÀI GIỜ — DẢI 3 BƯỚC ────────────────────────
// Ba bước đánh số, nối hairline. Viền sáng xanh (đầu sáng + đuôi mờ,
// lấy cảm hứng loader Uiverse) chạy 2 tia từ cạnh trái, sang bước kế,
// bước trước tắt dần cùng lúc bước sau sáng.
interface Step {
  title: string;
  desc: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  subheading?: string | null;
  steps: Step[];
}

const { eyebrow, heading, subheading, steps } = Astro.props;
---

<section class="ds-section">
  <div class="container">
    <header class="ds-head">
      <span class="ds-eyebrow">{eyebrow}</span>
      <h2 class="ds-heading">{heading}</h2>
      {subheading && <p class="ds-subheading">{subheading}</p>}
    </header>

    <ol class="ds-steps" role="list" data-ds-trace>
      {
        steps.map((s, i) => (
          <li class="ds-step" data-step={i}>
            <svg class="ds-trace" aria-hidden="true">
              <defs>
                <filter
                  id={`ds-glow-${i}`}
                  x="-50%"
                  y="-50%"
                  width="200%"
                  height="200%"
                  color-interpolation-filters="sRGB"
                >
                  <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>
              <path
                class="ds-ray ds-ray--glow ds-ray--top"
                fill="none"
                pathLength="1"
                filter={`url(#ds-glow-${i})`}
              />
              <path
                class="ds-ray ds-ray--glow ds-ray--bot"
                fill="none"
                pathLength="1"
                filter={`url(#ds-glow-${i})`}
              />
              <path class="ds-ray ds-ray--core ds-ray--top" fill="none" pathLength="1" />
              <path class="ds-ray ds-ray--core ds-ray--bot" fill="none" pathLength="1" />
            </svg>

            <span class="ds-head ds-head--top" aria-hidden="true"></span>
            <span class="ds-head ds-head--bot" aria-hidden="true"></span>

            {
              i < steps.length - 1 && (
                <div class="ds-link" aria-hidden="true">
                  <span class="ds-link-base" />
                  <span class="ds-link-beam" />
                  <span class="ds-link-head" />
                </div>
              )
            }

            <span class="ds-num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="ds-step-title">{s.title}</h3>
            <p class="ds-step-desc">{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ds-section {
    padding: 5rem 0;
  }

  .ds-head {
    max-width: 46rem;
    margin: 0 0 3rem;
  }
  .ds-eyebrow {
    display: inline-block;
    font-family: "Roboto", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    margin-bottom: 0.875rem;
  }
  .ds-heading {
    font-family: "Google Sans", sans-serif;
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    margin: 0 0 0.875rem;
    text-wrap: balance;
  }
  .ds-subheading {
    font-size: var(--fs-lead);
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    margin: 0;
    max-width: 55ch;
  }

  .ds-steps {
    --step-gap: 4.5rem;
    /* Chu kỳ: 3 hộp × (vẽ + nối) + nhịp nghỉ cuối */
    --ds-cycle: 9.6s;
    --ds-box: 22%;
    --ds-link: 7%;
    /* Mốc phần trăm trong chu kỳ (khớp keyframes bên dưới) */
    --ds-b0-end: 22%;
    --ds-l0-end: 29%;
    --ds-b1-end: 51%;
    --ds-l1-end: 58%;
    --ds-b2-end: 80%;
    --ds-hold-end: 90%;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--step-gap);
  }

  .ds-step {
    position: relative;
    isolation: isolate;
    overflow: visible;
    padding: 1.5rem 1.75rem;
    border-radius: var(--shape-card);
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--card));
  }

  /* ── SVG viền sáng ─────────────────────────────────────── */
  .ds-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .ds-ray {
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .ds-ray--glow {
    stroke-width: 5;
    stroke: hsl(221 100% 68% / 0.7);
  }
  .ds-ray--core {
    stroke-width: 2;
    stroke: hsl(221 100% 78%);
  }

  /* ── Đầu sáng kiểu loader (orb trắng + quầng xanh) ─────── */
  .ds-head {
    --hue: 221;
    --border: 7px;
    --blur: 7px;
    position: absolute;
    top: 0;
    left: 0;
    width: var(--border);
    aspect-ratio: 1;
    border-radius: 50%;
    background: white;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    offset-rotate: 0deg;
    box-shadow:
      0 0 6px 2px hsl(var(--hue) 100% 70%),
      0 0 14px 5px hsl(var(--hue) 100% 53% / 0.55);
  }
  .ds-head::before {
    content: "";
    position: absolute;
    inset: calc(var(--border) * -0.5);
    border-radius: 50%;
    background: white;
    filter: blur(var(--blur));
    z-index: -1;
    opacity: 0.85;
  }

  /* ── Đường nối + beam ──────────────────────────────────── */
  .ds-link {
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--step-gap));
    width: var(--step-gap);
    height: 0;
    transform: translateY(-50%);
    z-index: 0;
    pointer-events: none;
  }
  .ds-link-base {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: hsl(var(--border));
  }
  .ds-link-beam {
    position: absolute;
    left: 0;
    top: -1px;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    transform-origin: left center;
    transform: scaleX(0);
    opacity: 0;
    background: linear-gradient(
      90deg,
      hsl(221 100% 42% / 0.15),
      hsl(var(--primary)),
      hsl(221 100% 78%)
    );
    box-shadow:
      0 0 8px 1px hsl(221 100% 70% / 0.55),
      0 0 16px 2px hsl(var(--primary) / 0.35);
  }
  .ds-link-head {
    --hue: 221;
    --border: 7px;
    position: absolute;
    top: 0;
    left: 0;
    width: var(--border);
    aspect-ratio: 1;
    border-radius: 50%;
    background: white;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    box-shadow:
      0 0 6px 2px hsl(var(--hue) 100% 70%),
      0 0 14px 5px hsl(var(--hue) 100% 53% / 0.55);
  }
  .ds-link-head::before {
    content: "";
    position: absolute;
    inset: calc(var(--border) * -0.5);
    border-radius: 50%;
    background: white;
    filter: blur(7px);
    z-index: -1;
    opacity: 0.85;
  }

  /* ── Chạy khi section vào viewport ─────────────────────── */
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="0"] .ds-ray {
    animation: ds-ray-0 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="1"] .ds-ray {
    animation: ds-ray-1 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="2"] .ds-ray {
    animation: ds-ray-2 var(--ds-cycle) linear infinite;
  }

  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="0"] .ds-head--top {
    animation: ds-head-0 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="0"] .ds-head--bot {
    animation: ds-head-0 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="1"] .ds-head--top {
    animation: ds-head-1 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="1"] .ds-head--bot {
    animation: ds-head-1 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="2"] .ds-head--top {
    animation: ds-head-2 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="2"] .ds-head--bot {
    animation: ds-head-2 var(--ds-cycle) linear infinite;
  }

  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="0"] .ds-link-beam {
    animation: ds-link-beam-0 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="0"] .ds-link-head {
    animation: ds-link-head-0 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="1"] .ds-link-beam {
    animation: ds-link-beam-1 var(--ds-cycle) linear infinite;
  }
  :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-step[data-step="1"] .ds-link-head {
    animation: ds-link-head-1 var(--ds-cycle) linear infinite;
  }

  /* Hộp 0: vẽ 0→22%, giữ qua nối, tắt dần khi hộp 1 vẽ (29→51%) */
  @keyframes ds-ray-0 {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    22% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    29% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    51% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    90%,
    100% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
  }

  /* Hộp 1: vẽ 29→51%, giữ qua nối, tắt dần khi hộp 2 vẽ (58→80%) */
  @keyframes ds-ray-1 {
    0%,
    29% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    29.01% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    51% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    58% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    80% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    90%,
    100% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
  }

  /* Hộp 2: vẽ 58→80%, giữ, rồi tắt trước khi loop */
  @keyframes ds-ray-2 {
    0%,
    58% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    58.01% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    80% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    90% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    98% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    100% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
  }

  @keyframes ds-head-0 {
    0% {
      offset-distance: 0%;
      opacity: 1;
    }
    22% {
      offset-distance: 100%;
      opacity: 1;
    }
    29% {
      offset-distance: 100%;
      opacity: 1;
    }
    51% {
      offset-distance: 100%;
      opacity: 0;
    }
    90%,
    100% {
      offset-distance: 0%;
      opacity: 0;
    }
  }

  @keyframes ds-head-1 {
    0%,
    29% {
      offset-distance: 0%;
      opacity: 0;
    }
    29.01% {
      offset-distance: 0%;
      opacity: 1;
    }
    51% {
      offset-distance: 100%;
      opacity: 1;
    }
    58% {
      offset-distance: 100%;
      opacity: 1;
    }
    80% {
      offset-distance: 100%;
      opacity: 0;
    }
    90%,
    100% {
      offset-distance: 0%;
      opacity: 0;
    }
  }

  @keyframes ds-head-2 {
    0%,
    58% {
      offset-distance: 0%;
      opacity: 0;
    }
    58.01% {
      offset-distance: 0%;
      opacity: 1;
    }
    80% {
      offset-distance: 100%;
      opacity: 1;
    }
    90% {
      offset-distance: 100%;
      opacity: 1;
    }
    98% {
      offset-distance: 100%;
      opacity: 0;
    }
    100% {
      offset-distance: 0%;
      opacity: 0;
    }
  }

  @keyframes ds-link-beam-0 {
    0%,
    22% {
      transform: scaleX(0);
      opacity: 0;
    }
    22.01% {
      transform: scaleX(0);
      opacity: 1;
    }
    29% {
      transform: scaleX(1);
      opacity: 1;
    }
    51% {
      transform: scaleX(1);
      opacity: 0;
    }
    90%,
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes ds-link-head-0 {
    0%,
    22% {
      left: 0%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
    22.01% {
      left: 0%;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    29% {
      left: 100%;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    51% {
      left: 100%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
    90%,
    100% {
      left: 0%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
  }

  @keyframes ds-link-beam-1 {
    0%,
    51% {
      transform: scaleX(0);
      opacity: 0;
    }
    51.01% {
      transform: scaleX(0);
      opacity: 1;
    }
    58% {
      transform: scaleX(1);
      opacity: 1;
    }
    80% {
      transform: scaleX(1);
      opacity: 0;
    }
    90%,
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes ds-link-head-1 {
    0%,
    51% {
      left: 0%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
    51.01% {
      left: 0%;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    58% {
      left: 100%;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    80% {
      left: 100%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
    90%,
    100% {
      left: 0%;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }
  }

  .ds-num {
    display: block;
    font-family: "Google Sans", sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: hsl(var(--primary) / 0.35);
    font-variant-numeric: tabular-nums;
    margin-bottom: 1rem;
  }
  .ds-step-title {
    font-family: "Google Sans", sans-serif;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.25;
    color: hsl(var(--foreground));
    margin: 0 0 0.5rem;
  }
  .ds-step-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  @media (max-width: 1100px) {
    .ds-steps {
      --step-gap: 2.25rem;
    }
  }

  @media (max-width: 860px) {
    .ds-steps {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .ds-link {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-ray,
    :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-head,
    :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-link-beam,
    :global(.scroll-animate--visible) .ds-steps[data-ds-ready] .ds-link-head {
      animation: none !important;
    }
    .ds-ray,
    .ds-head,
    .ds-link-beam,
    .ds-link-head {
      opacity: 0 !important;
    }
  }
</style>

<script>
  function halfPaths(w, h, r) {
    const radius = Math.min(r, w / 2, h / 2);
    const midY = h / 2;
    const top = [
      `M 0 ${midY}`,
      `L 0 ${radius}`,
      `A ${radius} ${radius} 0 0 1 ${radius} 0`,
      `L ${w - radius} 0`,
      `A ${radius} ${radius} 0 0 1 ${w} ${radius}`,
      `L ${w} ${midY}`,
    ].join(" ");
    const bot = [
      `M 0 ${midY}`,
      `L 0 ${h - radius}`,
      `A ${radius} ${radius} 0 0 0 ${radius} ${h}`,
      `L ${w - radius} ${h}`,
      `A ${radius} ${radius} 0 0 0 ${w} ${h - radius}`,
      `L ${w} ${midY}`,
    ].join(" ");
    return { top, bot };
  }

  function layoutStep(step) {
    const svg = step.querySelector(".ds-trace");
    if (!svg) return;

    const w = step.clientWidth;
    const h = step.clientHeight;
    if (w < 2 || h < 2) return;

    const styles = getComputedStyle(step);
    const r =
      parseFloat(styles.borderTopLeftRadius) ||
      parseFloat(styles.borderRadius) ||
      20;

    // Path sits on the border centerline (0.5px inset).
    const inset = 0.5;
    const { top, bot } = halfPaths(
      Math.max(w - inset * 2, 2),
      Math.max(h - inset * 2, 2),
      Math.max(r - inset, 0),
    );

    // Translate path into full card coordinates so SVG viewBox = card size
    // and offset-path on heads (also card-sized) share the same geometry.
    const map = (d) =>
      d.replace(
        /([ML])\s*([\d.-]+)\s+([\d.-]+)|A\s*([\d.-]+)\s+([\d.-]+)\s+([\d.-]+)\s+(\d)\s+(\d)\s+([\d.-]+)\s+([\d.-]+)/g,
        (_m, cmd, x, y, rx, ry, rot, large, sweep, ax, ay) => {
          if (cmd) return `${cmd} ${Number(x) + inset} ${Number(y) + inset}`;
          return `A ${rx} ${ry} ${rot} ${large} ${sweep} ${Number(ax) + inset} ${Number(ay) + inset}`;
        },
      );

    const topPath = map(top);
    const botPath = map(bot);

    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    step.querySelectorAll(".ds-ray--top").forEach((p) => {
      p.setAttribute("d", topPath);
    });
    step.querySelectorAll(".ds-ray--bot").forEach((p) => {
      p.setAttribute("d", botPath);
    });

    const headTop = step.querySelector(".ds-head--top");
    const headBot = step.querySelector(".ds-head--bot");
    if (headTop) headTop.style.offsetPath = `path('${topPath}')`;
    if (headBot) headBot.style.offsetPath = `path('${botPath}')`;
  }

  function layoutAll(root) {
    root.querySelectorAll(".ds-step").forEach(layoutStep);
    const ready = [...root.querySelectorAll(".ds-ray--top")].every((p) =>
      p.getAttribute("d"),
    );
    if (ready) root.setAttribute("data-ds-ready", "");
  }

  function init() {
    const root = document.querySelector("[data-ds-trace]");
    if (!root || root.dataset.dsInit === "1") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    root.dataset.dsInit = "1";

    layoutAll(root);

    const ro = new ResizeObserver(() => layoutAll(root));
    ro.observe(root);
    root.querySelectorAll(".ds-step").forEach((el) => ro.observe(el));
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
