---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NotFoundHero from "../../components/NotFoundHero.astro";
import { SITE } from "../../config/site";
import { NAV } from "../../config/nav";

// Trước đây route này KHÔNG tồn tại, dù en/legal/[slug].astro redirect tới nó.
Astro.response.status = 404;

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={`404 — Page not found · ${SITE.brandName}`}
  description="The page you are looking for does not exist."
  lang="en"
>
  <Header />

  <NotFoundHero
    heading="Page not found"
    homeLabel="Go home"
    homeHref={`/en${NAV.home}`}
    contactLabel="Contact"
    contactHref={`/en${NAV.contact}`}
  />

  <Footer />
</BaseLayout>
