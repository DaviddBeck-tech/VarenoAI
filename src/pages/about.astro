---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import AboutStory from "../components/AboutStory.astro";
import ValuesSection from "../components/ValuesSection.astro";
import EcosystemShowcase from "../components/EcosystemShowcase.astro";
import PrivacySection from "../components/PrivacySection.astro";
import FounderNote from "../components/FounderNote.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../config/site";
import { ABOUT } from "../config/about";

// Trang tĩnh, không fetch WordPress → cache lâu tại edge.
Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=3600, stale-while-revalidate=86400",
);

const lang = "vi" as const;

const seo = {
  title: `Giới thiệu — ${SITE.brandName}`,
  description:
    "VarenoAI xây dựng các sản phẩm AI dành riêng cho doanh nghiệp Việt: hiểu tiếng Việt bản địa, triển khai trong vài giờ, không cần đội kỹ thuật.",
};
---

<BaseLayout title={seo.title} description={seo.description}>
  <Header />

  <PageHero
    badge={ABOUT.hero.badge[lang]}
    title={ABOUT.hero.titleLead[lang]}
    titleHighlight={ABOUT.hero.titleAccent[lang]}
    subtitle={ABOUT.hero.subtitle[lang]}
  />

  <AboutStory
    eyebrow={ABOUT.story.eyebrow[lang]}
    heading={ABOUT.story.heading[lang]}
    headingAccent={ABOUT.story.headingAccent[lang]}
    paragraphs={ABOUT.story.paragraphs[lang].slice()}
    missionLabel={ABOUT.story.missionLabel[lang]}
    mission={ABOUT.story.mission[lang]}
    points={ABOUT.story.points[lang].slice()}
    stats={ABOUT.story.stats.map((s) => ({
      value: s.value,
      label: s.label[lang],
    }))}
  />

  <FounderNote
    eyebrow={ABOUT.letter.eyebrow[lang]}
    heading={ABOUT.letter.heading[lang]}
    paragraphs={ABOUT.letter.paragraphs[lang].slice()}
    signature={ABOUT.letter.signature[lang]}
    signatureRole={ABOUT.letter.signatureRole[lang]}
  />

  <ValuesSection
    title={ABOUT.values.title[lang]}
    titleAccent={ABOUT.values.titleAccent[lang]}
    subtitle={ABOUT.values.subtitle[lang]}
    pillars={ABOUT.values.pillars.map((p) => ({
      icon: p.icon,
      title: p.title[lang],
      desc: p.desc[lang],
      points: p.points[lang].slice(),
    }))}
  />

  <EcosystemShowcase
    title={ABOUT.ecosystem.title[lang]}
    subtitle={ABOUT.ecosystem.subtitle[lang]}
  />

  <PrivacySection
    title={ABOUT.privacy.title[lang]}
    description={ABOUT.privacy.description[lang]}
    linkText={ABOUT.privacy.linkText[lang]}
    linkUrl="/legal/privacy-policy/"
  />

  <CtaBand />

  <Footer />
</BaseLayout>
