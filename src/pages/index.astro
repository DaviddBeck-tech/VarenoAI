---
// ── TRANG CHỦ UMBRELLA (VarenoAI) ───────────────────────────────
// Sáu section, mỗi section một HỌ BỐ CỤC khác nhau:
//   Hero (split lệch) → EcosystemShowcase (nền tảng đỡ lưới sản phẩm)
//   → Values (tuyên ngôn + danh sách hairline) → Industries (dải chip)
//   → News (thẻ bài viết) → Cta (dải toàn chiều ngang)
//
// Đã cắt so với bản trước:
//   · ChannelStrip   — Website/Zalo OA/Messenger là kênh riêng của ChatVareno
//   · HowVarenoWorks — quy trình riêng của ChatVareno
//   · ProductsSpotlight + EcosystemSection — cùng render navProducts() HAI LẦN
//     liên tiếp; nay gộp vào EcosystemShowcase
//
// MỌI copy đọc từ src/content/home.ts. File này và bản /en phải giữ CÙNG cấu
// trúc; khác biệt duy nhất là `lang` và translatePath.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import UmbrellaHero from "../components/UmbrellaHero.astro";
import EcosystemShowcase from "../components/EcosystemShowcase.astro";
import ValuesSection from "../components/ValuesSection.astro";
import IndustriesSection from "../components/IndustriesSection.astro";
import NewsSection from "../components/NewsSection.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import { getPosts } from "../lib/wordpress";
import { SITE } from "../config/site";
import { NAV } from "../config/nav";
import { HOME } from "../config/home";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=60, stale-while-revalidate=86400",
);

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const seo = {
  title: `${SITE.brandName}: Hệ sinh thái AI cho doanh nghiệp Việt`,
  description:
    "VarenoAI xây dựng các sản phẩm AI cho doanh nghiệp Việt: ChatVareno tư vấn & bán hàng tự động, ContentAI sản xuất nội dung.",
};

// Tin tức: fetch an toàn — chưa có WordPress thì NewsSection tự hiện empty state.
let posts: Awaited<ReturnType<typeof getPosts>> = [];
try {
  posts = await getPosts(3, "vi");
} catch (e) {
  console.error("[index] Không lấy được bài viết:", e);
}
---

<BaseLayout title={seo.title} description={seo.description}>
  <div class="min-h-screen">
    <Header />

    <UmbrellaHero
      badgeText={HOME.hero.badge[lang]}
      titleLead={HOME.hero.titleLead[lang]}
      rotatingWords={HOME.hero.rotating.map((r) => r[lang])}
      subtitle={HOME.hero.subtitle[lang]}
      imageAlt={HOME.hero.imageAlt[lang]}
      btn1Text={HOME.hero.primaryCta.label[lang]}
      btn1Link={translatePath(HOME.hero.primaryCta.href)}
      btn2Text={HOME.hero.secondaryCta.label[lang]}
      btn2Link={translatePath(HOME.hero.secondaryCta.href)}
      chips={HOME.platform.capabilities.map((c) => c[lang])}
    />

    <EcosystemShowcase
      title={HOME.showcase.title[lang]}
      subtitle={HOME.showcase.subtitle[lang]}
    />

    <ValuesSection
      title={HOME.values.title[lang]}
      titleAccent={HOME.values.titleAccent[lang]}
      subtitle={HOME.values.subtitle[lang]}
      pillars={HOME.values.pillars.map((p) => ({
        icon: p.icon,
        title: p.title[lang],
        desc: p.desc[lang],
        points: p.points.map((pt) => pt[lang]),
      }))}
    />

    <IndustriesSection
      title={HOME.industries.title[lang]}
      titleHighlight={HOME.industries.titleAccent[lang]}
      subtitle={HOME.industries.subtitle[lang]}
      industries={HOME.industries.items.map((it) => ({
        name: it.name[lang],
        blurb: it.blurb[lang],
        icon: it.icon,
        featured: it.featured ?? false,
        href: translatePath(HOME.industries.href),
      }))}
    />

    <NewsSection
      title={HOME.news.title[lang]}
      subtitle={HOME.news.subtitle[lang]}
      posts={posts}
      basePath="/blog"
      viewAllHref={translatePath(NAV.news)}
      viewAllLabel={HOME.news.viewAll[lang]}
      emptyText={HOME.news.empty[lang]}
    />

    <CtaBand />

    <Footer />
  </div>
</BaseLayout>
